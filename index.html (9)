.btn-download{background:linear-gradient(135deg,#3b82f6,#06b6d4);}
.btn-fav{background:rgba(255,255,255,.06);border:1px solid var(--border);}

.modal-close{
  position:absolute;
  top:14px;
  right:14px;
  width:38px;
  height:38px;
  border-radius:50%;
  background:rgba(0,0,0,.7);
  border:1px solid rgba(255,255,255,.15);
  color:#fff;
  font-size:18px;
  cursor:pointer;
  z-index:5;
}

.modal-close:hover{background:var(--danger);transform:rotate(90deg);}

/* Status selector in modal */
.status-selector{
