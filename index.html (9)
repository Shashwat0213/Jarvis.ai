<meta name='viewport' content='width=device-width, initial-scale=1'/><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-version" content="CineVault V1 • Universal Movie Tracker">
<title>CineVault -- Your Personal Movie Universe</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* =========================================================
   CINEVAULT -- GLOBAL
========================================================= */
*{margin:0;padding:0;box-sizing:border-box;}

:root{
  --bg:#0a0710;
  --bg2:#12091f;
  --card:#160f28;
  --card2:#1c1332;
  --primary:#ffb800;
  --primary-2:#ff8c42;
  --accent:#a855f7;
  --accent-2:#ec4899;
  --text:#ffffff;
  --muted:#a89bc4;
  --border:#2a1f4a;
  --success:#22c55e;
  --danger:#ef4444;
  --shadow:0 0 25px rgba(255,184,0,.18);
  --strong-shadow:0 0 40px rgba(255,184,0,.28);
}

html{scroll-behavior:smooth;}

body{
  font-family:"Poppins",sans-serif;
  background:
    radial-gradient(circle at 15% 0%, rgba(168,85,247,.18), transparent 35%),
    radial-gradient(circle at 85% 10%, rgba(255,184,0,.10), transparent 30%),
    var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
  position:relative;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  background-image:
    radial-gradient(circle, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size:32px 32px;
  pointer-events:none;
  z-index:-2;
}

body::after{
  content:"";
  position:fixed;
  inset:0;
  background:radial-gradient(circle at center, transparent 30%, rgba(0,0,0,.5) 100%);
  pointer-events:none;
  z-index:-1;
}

.container{
  width:94%;
  max-width:1400px;
  margin:auto;
  padding:22px 0 60px;
}

/* =========================================================
   HEADER
========================================================= */
header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  margin-bottom:26px;
  flex-wrap:wrap;
}

.logo{
  display:flex;
  flex-direction:column;
  font-family:"Bebas Neue",sans-serif;
  font-size:2.4rem;
  letter-spacing:2px;
  color:var(--primary);
  text-shadow:0 0 18px rgba(255,184,0,.55);
  line-height:1;
}

.logo span{
  font-family:"Poppins",sans-serif;
  font-size:.6rem;
  font-weight:700;
  letter-spacing:4px;
  color:var(--muted);
  margin-top:6px;
  text-transform:uppercase;
}

.topbar{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  align-items:center;
}

button{
  border:none;
  outline:none;
  border-radius:12px;
  font-family:"Poppins",sans-serif;
  cursor:pointer;
  transition:.25s ease;
  font-weight:600;
}

.top-btn{
  padding:11px 16px;
  background:linear-gradient(135deg,var(--primary),var(--primary-2));
  color:#0a0710;
  font-weight:700;
  box-shadow:var(--shadow);
  font-size:.82rem;
}

.top-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 0 25px rgba(255,184,0,.45);
}

.ghost-btn{
  padding:11px 16px;
  background:var(--card);
  color:var(--text);
  border:1px solid var(--border);
  font-size:.82rem;
}

.ghost-btn:hover{
  border-color:var(--primary);
  color:var(--primary);
}

/* =========================================================
   AUTH BAR
========================================================= */
.auth-bar{
  display:flex;
  justify-content:flex-end;
  align-items:center;
  gap:10px;
  margin:8px 0 18px;
}

.auth-user{
  display:none;
  align-items:center;
  gap:10px;
}

.auth-avatar{
  width:38px;
  height:38px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#0a0710;
  font-weight:800;
  font-size:.95rem;
}

.auth-user strong{
  font-size:.85rem;
  max-width:140px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.auth-login-btn,.auth-logout-btn,.auth-admin-btn{
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  border-radius:12px;
  padding:10px 14px;
  cursor:pointer;
  font-weight:600;
  font-size:.8rem;
}

.auth-login-btn{
  background:linear-gradient(135deg,var(--primary),var(--primary-2));
  color:#0a0710;
  border:0;
}

.auth-admin-btn{
  background:linear-gradient(135deg,var(--accent),var(--accent-2));
  color:#fff;
  border:0;
}

/* =========================================================
   AUTH MODAL
========================================================= */
.auth-overlay{
  position:fixed;
  inset:0;
  z-index:9999;
  display:none;
  align-items:center;
  justify-content:center;
  padding:18px;
  background:rgba(5,3,12,.85);
  backdrop-filter:blur(14px);
}

.auth-overlay.open{display:flex;}

.auth-card{
  width:min(460px,100%);
  padding:28px;
  border-radius:24px;
  background:linear-gradient(145deg,#1a1030,#0d0819);
  border:1px solid var(--border);
  box-shadow:0 30px 90px rgba(0,0,0,.65);
  position:relative;
}

.auth-close{
  position:absolute;
  right:14px;
  top:10px;
  background:transparent;
  border:0;
  color:var(--muted);
  font-size:26px;
  cursor:pointer;
}

.auth-brand{
  font-size:.7rem;
  letter-spacing:3px;
  color:var(--primary);
  font-weight:800;
  margin-bottom:8px;
}

.auth-card h2{
  font-family:"Bebas Neue",sans-serif;
  font-size:2rem;
  letter-spacing:1px;
  margin-bottom:6px;
}

.auth-card p{
  color:var(--muted);
  font-size:.85rem;
  margin-bottom:18px;
}

.auth-tabs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-bottom:18px;
  background:rgba(255,255,255,.04);
  padding:5px;
  border-radius:12px;
}

.auth-tab{
  padding:10px;
  border-radius:9px;
  border:0;
  background:transparent;
  color:var(--muted);
  cursor:pointer;
  font-weight:600;
  font-size:.82rem;
}

.auth-tab.active{
  background:rgba(255,184,0,.15);
  color:var(--primary);
}

.auth-form{display:grid;gap:13px;}

.auth-field{display:grid;gap:6px;}

.auth-field label{
  font-size:.75rem;
  color:var(--muted);
  font-weight:600;
}

.auth-field input{
  width:100%;
  padding:12px 13px;
  border-radius:10px;
  border:1px solid var(--border);
  background:rgba(0,0,0,.28);
  color:#fff;
  outline:none;
  font-family:inherit;
  font-size:.85rem;
}

.auth-field input:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px rgba(255,184,0,.15);
}

.auth-submit{
  padding:13px;
  border:0;
  border-radius:11px;
  background:linear-gradient(135deg,var(--primary),var(--primary-2));
  color:#0a0710;
  font-weight:800;
  cursor:pointer;
  font-size:.85rem;
  letter-spacing:.5px;
}

.auth-message{
  min-height:18px;
  color:#ff9b9b;
  font-size:.78rem;
  font-weight:600;
}

.auth-note{
  margin-top:14px;
  color:var(--muted);
  font-size:.68rem;
  line-height:1.5;
}

/* =========================================================
   HERO
========================================================= */
.hero{
  position:relative;
  overflow:hidden;
  margin:16px 0 24px;
  padding:38px 32px;
  border:1px solid var(--border);
  border-radius:26px;
  background:
    linear-gradient(120deg, rgba(10,7,16,.96), rgba(26,10,45,.85));
  box-shadow:0 25px 80px rgba(0,0,0,.45);
  isolation:isolate;
}

.hero::before{
  content:"";
  position:absolute;
  inset:-40%;
  background:
    conic-gradient(from 130deg, transparent 0 40%, var(--primary) 48%, transparent 55%, var(--accent) 70%, transparent 78%);
  filter:blur(75px);
  opacity:.15;
  z-index:-2;
  animation:heroSpin 22s linear infinite;
}

.hero::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg, rgba(0,0,0,.7), transparent 75%);
  z-index:-1;
}

@keyframes heroSpin{to{transform:rotate(360deg);}}

.hero-kicker{
  font-size:.72rem;
  letter-spacing:4px;
  font-weight:800;
  color:var(--primary);
  text-transform:uppercase;
  margin-bottom:12px;
}

.hero-title{
  font-family:"Bebas Neue",sans-serif;
  font-size:clamp(2.4rem,6vw,4.4rem);
  line-height:.95;
  letter-spacing:1px;
  margin-bottom:14px;
  background:linear-gradient(90deg,#fff 30%,var(--primary) 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.hero-copy{
  max-width:640px;
  color:rgba(255,255,255,.7);
  line-height:1.65;
  font-size:.9rem;
  margin-bottom:22px;
}

.hero-actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.hero-btn{
  padding:13px 20px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.15);
  background:rgba(255,255,255,.06);
  color:#fff;
  font-weight:700;
  font-size:.82rem;
  cursor:pointer;
  transition:.25s;
}

.hero-btn.primary{
  background:linear-gradient(135deg,var(--primary),var(--primary-2));
  border:0;
  color:#0a0710;
  box-shadow:0 8px 28px rgba(255,184,0,.32);
}

.hero-btn:hover{transform:translateY(-2px);}

/* =========================================================
   THEME SWITCHER
========================================================= */
.theme-switcher{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:22px;
  padding:10px 14px;
  border:1px solid var(--border);
  border-radius:16px;
  background:rgba(255,255,255,.03);
}

.theme-label{
  font-size:.72rem;
  font-weight:800;
  letter-spacing:2px;
  color:var(--muted);
  text-transform:uppercase;
  margin-right:6px;
}

.theme-choice{
  padding:8px 13px;
  border-radius:999px;
  border:1px solid var(--border);
  background:rgba(255,255,255,.04);
  color:var(--text);
  font-size:.72rem;
  font-weight:600;
  cursor:pointer;
  transition:.25s;
}

.theme-choice.active{
  border-color:var(--primary);
  color:var(--primary);
  box-shadow:0 0 0 2px rgba(255,184,0,.15);
}

/* Hero theme variants */
body.theme-gold{--primary:#ffb800;--primary-2:#ff8c42;}
body.theme-blue{--primary:#3b82f6;--primary-2:#06b6d4;}
body.theme-purple{--primary:#a855f7;--primary-2:#ec4899;}
body.theme-green{--primary:#22c55e;--primary-2:#84cc16;}
body.theme-red{--primary:#ef4444;--primary-2:#f97316;}

/* =========================================================
   SEARCH SECTION -- UNIVERSAL
========================================================= */
.search-section{
  margin-bottom:24px;
  position:relative;
  z-index:5;
}

.search-label{
  font-family:"Bebas Neue",sans-serif;
  font-size:1.4rem;
  letter-spacing:1px;
  color:var(--primary);
  margin-bottom:10px;
  display:flex;
  align-items:center;
  gap:10px;
}

.search-label small{
  font-family:"Poppins",sans-serif;
  font-size:.62rem;
  font-weight:600;
  letter-spacing:1px;
  color:var(--muted);
  text-transform:uppercase;
}

.search-box{
  position:relative;
}

.search-box input{
  width:100%;
  padding:17px 55px 17px 55px;
  background:var(--card);
  color:var(--text);
  border:1.5px solid var(--border);
  border-radius:16px;
  outline:none;
  font-family:inherit;
  font-size:.92rem;
  box-shadow:var(--shadow);
  transition:.3s;
}

.search-box input::placeholder{color:#6f608f;}

.search-box input:focus{
  border-color:var(--primary);
  box-shadow:0 0 22px rgba(255,184,0,.25);
}

.search-icon{
  position:absolute;
  left:19px;
  top:50%;
  transform:translateY(-50%);
  font-size:20px;
  pointer-events:none;
}

.search-clear{
  position:absolute;
  right:14px;
  top:50%;
  transform:translateY(-50%);
  background:rgba(255,255,255,.06);
  border:0;
  color:var(--muted);
  width:32px;
  height:32px;
  border-radius:50%;
  cursor:pointer;
  display:none;
  align-items:center;
  justify-content:center;
  font-size:15px;
}

.search-clear:hover{background:rgba(255,80,80,.2);color:#fff;}
.search-clear.visible{display:flex;}

/* Search suggestions dropdown */
.search-dropdown{
  position:absolute;
  top:calc(100% + 8px);
  left:0;
  right:0;
  max-height:480px;
  overflow-y:auto;
  background:linear-gradient(145deg,#1a1030,#0d0819);
  border:1px solid var(--border);
  border-radius:18px;
  box-shadow:0 25px 60px rgba(0,0,0,.6);
  padding:8px;
  display:none;
  z-index:100;
}

.search-dropdown.open{display:block;}

.search-section-title{
  padding:9px 14px 5px;
  font-size:.6rem;
  letter-spacing:2px;
  color:var(--muted);
  text-transform:uppercase;
  font-weight:800;
}

.search-result{
  display:flex;
  gap:12px;
  padding:9px;
  border-radius:12px;
  cursor:pointer;
  transition:.2s;
  align-items:center;
}

.search-result:hover,
.search-result.active{
  background:rgba(255,184,0,.10);
}

.search-result img{
  width:48px;
  height:72px;
  object-fit:cover;
  border-radius:8px;
  border:1px solid var(--border);
  flex-shrink:0;
  background:#160f28;
}

.search-result-info{flex:1;min-width:0;}

.search-result-info strong{
  display:block;
  font-size:.85rem;
  font-weight:600;
  color:#fff;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.search-result-info small{
  display:block;
  color:var(--muted);
  font-size:.68rem;
  margin-top:4px;
}

.search-result-add{
  padding:7px 12px;
  border-radius:9px;
  background:linear-gradient(135deg,var(--primary),var(--primary-2));
  color:#0a0710;
  font-weight:800;
  font-size:.68rem;
  border:0;
  cursor:pointer;
  white-space:nowrap;
}

.search-empty{
  padding:24px 16px;
  text-align:center;
  color:var(--muted);
  font-size:.8rem;
}

.search-loading{
  padding:22px;
  text-align:center;
  color:var(--primary);
  font-size:.78rem;
}

/* =========================================================
   STATS DASHBOARD
========================================================= */
.stats{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:12px;
  margin-bottom:22px;
}

.stat-card{
  background:linear-gradient(145deg,var(--card2),var(--card));
  border:1px solid var(--border);
  border-radius:16px;
  padding:16px 12px;
  text-align:center;
  transition:.3s;
  position:relative;
  overflow:hidden;
  cursor:pointer;
}

.stat-card::before{
  content:"";
  position:absolute;
  width:70px;
  height:70px;
  background:rgba(255,184,0,.08);
  border-radius:50%;
  top:-35px;
  right:-35px;
}

.stat-card:hover{
  transform:translateY(-3px);
  border-color:var(--primary);
  box-shadow:var(--shadow);
}

.stat-card.active{
  border-color:var(--primary);
  background:linear-gradient(145deg,rgba(255,184,0,.12),var(--card));
}

.stat-icon{font-size:20px;margin-bottom:6px;}

.stat-number{
  display:block;
  font-family:"Bebas Neue",sans-serif;
  font-size:1.7rem;
  letter-spacing:1px;
  color:var(--primary);
  margin-bottom:2px;
  line-height:1;
}

.stat-label{
  font-size:.6rem;
  color:var(--muted);
  letter-spacing:1.5px;
  text-transform:uppercase;
  font-weight:600;
}

/* =========================================================
   PROGRESS
========================================================= */
.progress-section{margin-bottom:22px;}

.progress-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:9px;
}

.progress-title{
  font-size:.72rem;
  color:var(--muted);
  letter-spacing:1.5px;
  text-transform:uppercase;
  font-weight:600;
}

.progress-percent{
  color:var(--primary);
  font-weight:700;
  font-size:.8rem;
}

.progress{
  width:100%;
  height:12px;
  background:rgba(255,255,255,.06);
  border-radius:20px;
  overflow:hidden;
  border:1px solid var(--border);
}

.progress-bar{
  width:0%;
  height:100%;
  background:linear-gradient(90deg,var(--primary),var(--primary-2),var(--accent));
  transition:.5s ease;
  box-shadow:0 0 15px rgba(255,184,0,.5);
}

/* =========================================================
   FILTER + SORT
========================================================= */
.filter-bar{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:20px;
  align-items:center;
}

.filter-btn{
  padding:9px 14px;
  background:var(--card);
  color:var(--muted);
  border:1px solid var(--border);
  font-size:.72rem;
  font-weight:600;
}

.filter-btn:hover{color:#fff;border-color:var(--primary);}

.filter-btn.active{
  background:linear-gradient(135deg,var(--primary),var(--primary-2));
  color:#0a0710;
  border-color:transparent;
  box-shadow:var(--shadow);
}

.sort-box{margin-left:auto;}

.sort-box select{
  padding:9px 12px;
  border-radius:10px;
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  font-family:inherit;
  font-size:.72rem;
  outline:none;
  cursor:pointer;
}

/* =========================================================
   MOVIE GRID
========================================================= */
.movie-list{
  list-style:none;
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
  gap:16px;
}

.movie-card{
  background:linear-gradient(145deg,var(--card2),var(--card));
  border:1px solid var(--border);
  border-radius:16px;
  overflow:hidden;
  position:relative;
  transition:.35s ease;
  box-shadow:0 8px 25px rgba(0,0,0,.3);
  cursor:pointer;
}

.movie-card:hover{
  transform:translateY(-6px) scale(1.01);
  border-color:var(--primary);
  box-shadow:0 0 25px rgba(255,184,0,.22), 0 15px 35px rgba(0,0,0,.4);
}

.poster-container{
  height:290px;
  position:relative;
  overflow:hidden;
  background:linear-gradient(135deg,#1c1332,#0a0710);
}

.poster{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:.5s ease;
}

.movie-card:hover .poster{transform:scale(1.06);}

.poster-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(to top, rgba(10,7,16,.96) 8%, transparent 55%);
  pointer-events:none;
}

.status-badge{
  position:absolute;
  top:10px;
  left:10px;
  padding:5px 9px;
  border-radius:8px;
  background:rgba(0,0,0,.75);
  backdrop-filter:blur(8px);
  border:1px solid rgba(255,184,0,.35);
  color:var(--primary);
  font-size:.55rem;
  font-weight:800;
  letter-spacing:.5px;
  z-index:2;
  text-transform:uppercase;
}

.favorite-btn{
  position:absolute;
  top:10px;
  right:10px;
  width:34px;
  height:34px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:rgba(0,0,0,.72);
  color:#fff;
  border:1px solid rgba(255,255,255,.15);
  font-size:15px;
  z-index:3;
  cursor:pointer;
}

.favorite-btn:hover{transform:scale(1.1);background:rgba(255,184,0,.8);}

.favorite-btn.active{
  color:var(--primary);
  text-shadow:0 0 10px var(--primary);
}

.movie-info{padding:13px;}

.movie-title{
  font-size:.82rem;
  line-height:1.4;
  min-height:38px;
  margin-bottom:9px;
  color:#fff;
  font-weight:600;
}

.movie-meta{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
  margin-bottom:10px;
}

.meta-item{
  padding:4px 7px;
  border-radius:6px;
  background:rgba(255,255,255,.05);
  border:1px solid var(--border);
  color:var(--muted);
  font-size:.55rem;
  font-weight:600;
  white-space:nowrap;
}

.rating{
  color:var(--primary);
  font-weight:800;
}

/* =========================================================
   EMPTY STATE
========================================================= */
.empty-state{
  grid-column:1/-1;
  text-align:center;
  padding:60px 20px;
  color:var(--muted);
  border:1.5px dashed var(--border);
  border-radius:18px;
  background:rgba(22,15,40,.6);
}

.empty-icon{font-size:44px;margin-bottom:14px;opacity:.6;}

.empty-state h3{
