/* ---------------------------------------------------------
   8. ADMIN PANEL
--------------------------------------------------------- */
var adminPanel      = document.getElementById("adminPanel");
var adminPanelClose = document.getElementById("adminPanelClose");

function renderAdminUsers(users){
  var list = document.getElementById("adminUserList");
  if(!list) return;

  if(!users.length){
    list.innerHTML = '<p style="color:var(--muted);font-size:.82rem;text-align:center;padding:20px">No users found.</p>';
    return;
  }

  list.innerHTML = users.map(function(u){
    return '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 14px;margin-bottom:7px;border:1px solid var(--border);border-radius:12px;background:rgba(255,255,255,.03)">' +
      '<div>' +
        '<strong style="font-size:.85rem">' + escapeHtml(u.displayName || "User") + '</strong>' +
        '<div style="color:var(--muted);font-size:.7rem;margin-top:3px">' + escapeHtml(u.email || "") + '</div>' +
      '</div>' +
      '<span style="padding:4px 10px;border-radius:999px;font-size:.65rem;font-weight:700;background:' +
        (u.role === "admin" ? "rgba(255,184,0,.18);color:#ffb800" : "rgba(255,255,255,.06);color:#a89bc4") + '">' +
        escapeHtml(u.role || "user") +
      '</span>' +
    '</div>';
  }).join("");
}

async function openAdminPanel(){
  if(!cvUser || !cvDb){
    alert("Please login with a Firebase account first.");
    return;
  }

  try{
    var token = await cvUser.getIdTokenResult(true);
    if(token.claims && token.claims.admin === true){
      cvAdmin = true;
    }
    // Also check Firestore role
    var userDoc = await cvDb.collection("users").doc(cvUser.uid).get();
    if(userDoc.exists && userDoc.data().role === "admin") cvAdmin = true;
  }catch(e){}

  if(!cvAdmin){
    alert("Admin access required. Your account needs role: 'admin' in Firestore.");
    return;
  }

  adminPanel.classList.add("open");
  adminPanel.setAttribute("aria-hidden", "false");

  try{
    var snap = await cvDb.collection("users").limit(200).get();
    var users = [];
    var totalMovies = 0, totalWatched = 0, totalFavs = 0;

    for(var i = 0; i < snap.docs.length; i++){
      var doc = snap.docs[i];
      var data = doc.data() || {};
      users.push({
        uid: doc.id,
        displayName: data.displayName || "",
        email: data.email || "",
        role: data.role || "user"
      });

      var vaultSnap = await cvDb.collection("users").doc(doc.id)
        .collection("data").doc("vault").get();
      if(vaultSnap.exists){
        var movies = vaultSnap.data().movies || [];
        totalMovies += movies.length;
        totalWatched += movies.filter(function(m){ return m.status === "watched"; }).length;
        totalFavs += movies.filter(function(m){ return m.favorite; }).length;
      }
    }

    document.getElementById("adminTotalUsers").textContent = users.length;
    document.getElementById("adminTotalMovies").textContent = totalMovies;
    document.getElementById("adminWatched").textContent = totalWatched;
    document.getElementById("adminFavs").textContent = totalFavs;

    renderAdminUsers(users);
  }catch(err){
    console.error("Admin load error:", err);
    document.getElementById("adminUserList").innerHTML =
      '<p style="color:var(--muted);text-align:center;padding:20px;font-size:.82rem">Could not load users. Check Firestore rules.</p>';
  }
}

if(adminPanelClose){
  adminPanelClose.addEventListener("click", function(){
    adminPanel.classList.remove("open");
    adminPanel.setAttribute("aria-hidden", "true");
  });
}
if(adminPanel){
  adminPanel.addEventListener("click", function(e){
    if(e.target === adminPanel){
      adminPanel.classList.remove("open");
      adminPanel.setAttribute("aria-hidden", "true");
    }
  });
}
if(authAdminBtn){
  authAdminBtn.addEventListener("click", openAdminPanel);
}

/* ---------------------------------------------------------
   9. UTIL
--------------------------------------------------------- */
function escapeHtml(s){
  return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){
    return { "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c];
  });
}

/* ---------------------------------------------------------
   10. INIT
--------------------------------------------------------- */
loadCollections();
renderCollections();

console.log("🎬 CineVault Part 3 loaded.");

})();
</script>