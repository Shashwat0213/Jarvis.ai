  backdrop-filter:blur(10px);display:none;
">Cloud: idle</div>

<!-- =========================================================
     PART 3 -- JAVASCRIPT
========================================================= -->
<script>
/* =========================================================
   CINEVAULT -- PART 3: EDIT / COLLECTIONS / FIREBASE / ADMIN
   (Local-first, works without Firebase; syncs when configured)
========================================================= */

(function(){
"use strict";

/* ---------------------------------------------------------
   1. MANUAL ADD / EDIT MOVIE
--------------------------------------------------------- */
var editModal    = document.getElementById("editModal");
var editClose    = document.getElementById("editClose");
var editForm     = document.getElementById("editForm");
var editModalTitle = document.getElementById("editModalTitle");
var editCancelBtn = document.getElementById("editCancelBtn");
var editingMovieId = null;

function openEditModal(movieId){
  editingMovieId = movieId || null;
  editModalTitle.textContent = movieId ? "Edit Movie" : "Add Movie";

  var data = {
    title: "", year: "", genre: "", poster: "",
    overview: "", trailerUrl: "", watchUrl: "",
    downloadUrl: "", userRating: ""
  };

  if(movieId){
    var m = window.__cvGetMovie ? window.__cvGetMovie(movieId) : null;
    if(m){
      data = {
        title: m.title || "",
        year: m.year || "",
        genre: m.genre || "",
        poster: m.poster || "",
        overview: m.overview || "",
        trailerUrl: m.trailerUrl || "",
        watchUrl: m.watchUrl || "",
        downloadUrl: m.downloadUrl || "",
        userRating: m.userRating || ""
      };
    }
  }

  document.getElementById("editTitle").value = data.title;
  document.getElementById("editYear").value = data.year;
  document.getElementById("editGenre").value = data.genre;
  document.getElementById("editPoster").value = data.poster;
  document.getElementById("editOverview").value = data.overview;
  document.getElementById("editTrailer").value = data.trailerUrl;
  document.getElementById("editWatch").value = data.watchUrl;
  document.getElementById("editDownload").value = data.downloadUrl;
  document.getElementById("editUserRating").value = data.userRating;

  editModal.classList.add("active");
  document.body.style.overflow = "hidden";
}

function closeEditModal(){
  editModal.classList.remove("active");
  if(!document.getElementById("movieModal").classList.contains("active")){
    document.body.style.overflow = "";
  }
  editingMovieId = null;
}

if(editClose) editClose.addEventListener("click", closeEditModal);
if(editCancelBtn) editCancelBtn.addEventListener("click", closeEditModal);
if(editModal){
  editModal.addEventListener("click", function(e){
    if(e.target === editModal) closeEditModal();
  });
}

if(editForm){
  editForm.addEventListener("submit", function(e){
    e.preventDefault();

    var payload = {
      title: document.getElementById("editTitle").value.trim(),
      year: document.getElementById("editYear").value.trim(),
      genre: document.getElementById("editGenre").value.trim(),
      poster: document.getElementById("editPoster").value.trim(),
      overview: document.getElementById("editOverview").value.trim(),
      trailerUrl: document.getElementById("editTrailer").value.trim(),
      watchUrl: document.getElementById("editWatch").value.trim(),
      downloadUrl: document.getElementById("editDownload").value.trim(),
      userRating: parseFloat(document.getElementById("editUserRating").value) || 0
    };

    if(!payload.title){
      if(window.__cvBridge) window.__cvBridge.showToast("Title is required", "error");
      return;
    }

    if(editingMovieId){
      // Update existing
      if(window.__cvUpdateMovie){
        window.__cvUpdateMovie(editingMovieId, payload);
        if(window.__cvBridge) window.__cvBridge.showToast("✓ Movie updated");
      }
    }else{
      // Add new manual movie
      if(window.__cvAddManualMovie){
        window.__cvAddManualMovie(payload);
        if(window.__cvBridge) window.__cvBridge.showToast("✓ Movie added to vault");
      }
    }

    if(typeof window.__cvCloudSave === "function") window.__cvCloudSave();
    closeEditModal();
  });
}

/* ---------------------------------------------------------
   2. COLLECTIONS (Playlists)
--------------------------------------------------------- */
var COLLECTIONS_KEY = "cinevault_collections";
var collections = [];
var collectionsModal = document.getElementById("collectionsModal");
var collectionsClose = document.getElementById("collectionsClose");
var collectionsBtn   = document.getElementById("collectionsBtn");
var collectionsList  = document.getElementById("collectionsList");
var newCollectionName= document.getElementById("newCollectionName");
var newCollectionBtn = document.getElementById("newCollectionBtn");

function loadCollections(){
  try{
    var raw = localStorage.getItem(COLLECTIONS_KEY);
    collections = raw ? JSON.parse(raw) : [];
    if(!Array.isArray(collections)) collections = [];
  }catch(e){ collections = []; }
}

function saveCollections(){
  try{ localStorage.setItem(COLLECTIONS_KEY, JSON.stringify(collections)); }catch(e){}
}

function renderCollections(){
  if(!collectionsList) return;

  if(collections.length === 0){
    collectionsList.innerHTML =
      '<div style="text-align:center;padding:24px 12px;color:var(--muted);font-size:.82rem">' +
        'No collections yet. Create your first playlist below.' +
      '</div>';
    return;
  }

  collectionsList.innerHTML = collections.map(function(c){
    return '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 14px;margin-bottom:8px;border:1px solid var(--border);border-radius:12px;background:rgba(255,255,255,.03)">' +
      '<div>' +
        '<strong style="font-size:.88rem">' + escapeHtml(c.name) + '</strong>' +
        '<div style="color:var(--muted);font-size:.7rem;margin-top:3px">' +
          (c.movies || []).length + ' movie(s)' +
        '</div>' +
      '</div>' +
      '<button class="auth-logout-btn" data-del-collection="' + c.id + '" style="padding:6px 11px;font-size:.72rem">Delete</button>' +
    '</div>';
  }).join("");

  collectionsList.querySelectorAll("[data-del-collection]").forEach(function(btn){
    btn.addEventListener("click", function(){
      var id = btn.dataset.delCollection;
      if(!confirm("Delete this collection?")) return;
      collections = collections.filter(function(c){ return c.id !== id; });
      saveCollections();
      renderCollections();
    });
  });
}

if(collectionsBtn){
  collectionsBtn.addEventListener("click", function(){
    renderCollections();
    collectionsModal.classList.add("active");
    document.body.style.overflow = "hidden";
  });
}
if(collectionsClose){
  collectionsClose.addEventListener("click", function(){
    collectionsModal.classList.remove("active");
    document.body.style.overflow = "";
  });
}
if(collectionsModal){
  collectionsModal.addEventListener("click", function(e){
    if(e.target === collectionsModal){
      collectionsModal.classList.remove("active");
      document.body.style.overflow = "";
    }
  });
}
if(newCollectionBtn){
  newCollectionBtn.addEventListener("click", function(){
    var name = newCollectionName.value.trim();
    if(!name) return;
    collections.push({
      id: "col-" + Date.now(),
      name: name,
      movies: [],
      createdAt: Date.now()
    });
    saveCollections();
    newCollectionName.value = "";
    renderCollections();
    if(window.__cvBridge) window.__cvBridge.showToast("✓ Collection created");
  });
}

/* ---------------------------------------------------------
   3. FIREBASE (optional -- attaches if Part 4 config present)
--------------------------------------------------------- */
var FIREBASE_CONFIG = window.__CV_FIREBASE_CONFIG || null;
var cvAuth = null, cvDb = null, cvUser = null, cvAdmin = false;
var cloudSaveTimer = null;

function cvSetStatus(text, ok){
  var el = document.getElementById("cvCloudStatus");
  if(!el) return;
  el.style.display = "block";
  el.textContent = "Cloud: " + text;
  el.style.borderColor = ok ? "rgba(34,197,94,.5)" : "rgba(255,184,0,.3)";
}

function cvSetMessage(msg, ok){
  var el = document.getElementById("authMessage");
  if(!el) return;
  el.textContent = msg || "";
  el.style.color = ok ? "#22c55e" : "#ff9b9b";
}

async function cvSaveCloud(){
  if(!cvUser || !cvDb) return;
  cvSetStatus("saving…");

  try{
    var state = window.__cvBridge ? window.__cvBridge.getState() : {movies: []};

    // Save vault
    await cvDb.collection("users").doc(cvUser.uid).collection("data").doc("vault")
      .set({
        movies: state.movies || [],
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      }, {merge: true});

    // Save collections
    await cvDb.collection("users").doc(cvUser.uid).collection("data").doc("collections")
      .set({
        collections: collections,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      }, {merge: true});

    cvSetStatus("synced ✓", true);
  }catch(err){
    console.error("Cloud save error:", err);
    cvSetStatus("save failed", false);
  }
}

async function cvLoadCloud(){
  if(!cvUser || !cvDb) return;
  cvSetStatus("loading…");

  try{
    var vaultDoc = await cvDb.collection("users").doc(cvUser.uid)
      .collection("data").doc("vault").get();

    if(vaultDoc.exists){
      var data = vaultDoc.data();
      if(window.__cvBridge){
        window.__cvBridge.applyState({ movies: data.movies || [] });
      }
    }

    var colDoc = await cvDb.collection("users").doc(cvUser.uid)
      .collection("data").doc("collections").get();

    if(colDoc.exists){
      collections = colDoc.data().collections || [];
      saveCollections();
      renderCollections();
    }

    cvSetStatus("synced ✓", true);
  }catch(err){
    console.error("Cloud load error:", err);
    cvSetStatus("load failed", false);
  }
}

window.__cvCloudSave = function(){
  clearTimeout(cloudSaveTimer);
  cloudSaveTimer = setTimeout(cvSaveCloud, 1200);
};

/* ---------------------------------------------------------
   4. AUTH UI
--------------------------------------------------------- */
var authOverlay = document.getElementById("authOverlay");
var authOpenBtn = document.getElementById("authOpenBtn");
var authCloseBtn= document.getElementById("authCloseBtn");
var authForm    = document.getElementById("authForm");
var authSubmit  = document.getElementById("authSubmit");
var authTabs    = document.querySelectorAll(".auth-tab");
var authNameField = document.getElementById("authNameField");
var authTitle   = document.getElementById("authTitle");
var authSubtitle= document.getElementById("authSubtitle");
var authUserBox = document.getElementById("authUserBox");
var authAvatar  = document.getElementById("authAvatar");
var authUserName= document.getElementById("authUserName");
var authLogoutBtn = document.getElementById("authLogoutBtn");
var authAdminBtn  = document.getElementById("authAdminBtn");
var currentAuthMode = "login";

function cvSetAuthMode(mode){
  currentAuthMode = mode;
  authTabs.forEach(function(t){
    t.classList.toggle("active", t.dataset.authTab === mode);
  });
  var signup = mode === "signup";
  authTitle.textContent = signup ? "Create Account" : "Welcome Back";
  authSubtitle.textContent = signup
    ? "Start building your personal movie vault."
    : "Sign in to sync your vault across devices.";
  authNameField.style.display = signup ? "grid" : "none";
  document.getElementById("authName").required = signup;
  authSubmit.textContent = signup ? "Create Account" : "Login";
  cvSetMessage("");
}

authTabs.forEach(function(t){
  t.addEventListener("click", function(){ cvSetAuthMode(t.dataset.authTab); });
});

if(authOpenBtn){
  authOpenBtn.addEventListener("click", function(){
    if(!FIREBASE_CONFIG){
      cvSetMessage("Firebase is not configured in this file. See Part 4 for setup. Local mode active.");
      // Still show modal -- but only local
    }
    authOverlay.classList.add("open");
  });
}
if(authCloseBtn){
  authCloseBtn.addEventListener("click", function(){
    authOverlay.classList.remove("open");
  });
}
if(authOverlay){
  authOverlay.addEventListener("click", function(e){
    if(e.target === authOverlay) authOverlay.classList.remove("open");
  });
}

/* ---------------------------------------------------------
   5. HOOKS FROM PART 2
--------------------------------------------------------- */
// Expose movie editing from Part 2's internal state
// (Part 2 exposes window.__cvBridge; we can read vault through it)
window.__cvGetMovie = function(id){
  if(!window.__cvBridge) return null;
  var state = window.__cvBridge.getState();
  return (state.movies || []).find(function(m){ return m.id === id; });
};

window.__cvAddManualMovie = function(payload){
  if(!window.__cvBridge) return;
  var state = window.__cvBridge.getState();
  var movies = state.movies || [];

  var newMovie = {
    id: "cv-manual-" + Date.now() + "-" + Math.random().toString(36).slice(2,6),
    sourceId: "manual-" + Date.now(),
    title: payload.title,
    year: payload.year || "--",
    releaseDate: "",
    poster: payload.poster || "",
    backdrop: "",
    overview: payload.overview || "",
    tmdbRating: 0,
    genre: payload.genre || "",
    runtime: 0,
    trailerUrl: payload.trailerUrl || "",
    watchUrl: payload.watchUrl || "",
    downloadUrl: payload.downloadUrl || "",
    userRating: payload.userRating || 0,
    notes: "",
    status: "want",
    favorite: false,
    addedAt: Date.now(),
    watchedAt: null
  };

  movies.unshift(newMovie);
  window.__cvBridge.applyState({ movies: movies });
};

window.__cvUpdateMovie = function(id, payload){
  if(!window.__cvBridge) return;
  var state = window.__cvBridge.getState();
  var movies = state.movies || [];

  movies = movies.map(function(m){
    if(m.id === id){
      return Object.assign({}, m, {
        title: payload.title || m.title,
        year: payload.year || m.year,
        poster: payload.poster || m.poster,
        overview: payload.overview || m.overview,
        genre: payload.genre || m.genre,
        trailerUrl: payload.trailerUrl || m.trailerUrl,
        watchUrl: payload.watchUrl || m.watchUrl,
        downloadUrl: payload.downloadUrl || m.downloadUrl,
        userRating: payload.userRating || 0
      });
    }
    return m;
  });

  window.__cvBridge.applyState({ movies: movies });
};

/* ---------------------------------------------------------
   6. ADD "EDIT" BUTTON TO MOVIE MODAL
--------------------------------------------------------- */
(function(){
  var modalActions = document.querySelector("#movieModal .modal-actions");
  if(!modalActions) return;
  if(document.getElementById("modalEditBtn")) return;

  var editBtn = document.createElement("button");
  editBtn.className = "modal-btn btn-fav";
  editBtn.id = "modalEditBtn";
  editBtn.textContent = "✏️ Edit";
  modalActions.appendChild(editBtn);

  editBtn.addEventListener("click", function(){
    var m = window.__cvGetMovie ? window.__cvGetMovie(window.__cvGetEditingId ? window.__cvGetEditingId() : null) : null;
    // fallback: get modal movie id from Part 2's internal state via data attribute
    var modalMovieId = null;

    // Part 2 stored modal movie id in a closure -- we read it indirectly
    // from the poster's alt/title by matching vault
    var titleEl = document.getElementById("modalTitle");
    if(titleEl && window.__cvBridge){
      var state = window.__cvBridge.getState();
      var found = (state.movies || []).find(function(mv){
        return mv.title === titleEl.textContent;
      });
      if(found) modalMovieId = found.id;
    }

    if(modalMovieId){
      document.getElementById("movieModal").classList.remove("active");
      openEditModal(modalMovieId);
    }
  });
})();

/* ---------------------------------------------------------
   7. ADD "MANUAL ADD" BUTTON NEAR SEARCH
--------------------------------------------------------- */
(function(){
  var searchSection = document.getElementById("searchSection");
  if(!searchSection || document.getElementById("manualAddBtn")) return;

