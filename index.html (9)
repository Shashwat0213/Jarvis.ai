<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CineVault -- Track Every Movie You Love</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
/* ============ RESET ============ */
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}

/* ============ THEMES ============ */
:root{
  --bg:#08060f;
  --bg-2:#100a1e;
  --surface:#15102a;
  --surface-2:#1d1538;
  --border:rgba(255,255,255,.08);
  --border-hover:rgba(255,255,255,.18);
  --text:#ffffff;
  --text-dim:#a39bbf;
  --text-mute:#6f6789;
  --primary:#ffb800;
  --primary-2:#ff8c42;
  --accent:#a855f7;
  --accent-2:#ec4899;
  --success:#22c55e;
  --danger:#ef4444;
  --shadow-glow:0 0 40px rgba(255,184,0,.15);
}

/* Accent themes */
body[data-accent="gold"]   {--primary:#ffb800;--primary-2:#ff8c42;--accent:#a855f7;--accent-2:#ec4899;}
body[data-accent="cyan"]   {--primary:#06b6d4;--primary-2:#3b82f6;--accent:#8b5cf6;--accent-2:#ec4899;}
body[data-accent="purple"] {--primary:#a855f7;--primary-2:#ec4899;--accent:#f472b6;--accent-2:#fb7185;}
body[data-accent="green"]  {--primary:#22c55e;--primary-2:#84cc16;--accent:#14b8a6;--accent-2:#06b6d4;}
body[data-accent="red"]    {--primary:#ef4444;--primary-2:#f97316;--accent:#f43f5e;--accent-2:#ec4899;}
body[data-accent="pink"]   {--primary:#ec4899;--primary-2:#f472b6;--accent:#a855f7;--accent-2:#8b5cf6;}

/* Light mode */
body.light{
  --bg:#f5f3fb;
  --bg-2:#ffffff;
  --surface:#ffffff;
  --surface-2:#f9f7ff;
  --border:rgba(0,0,0,.08);
  --border-hover:rgba(0,0,0,.18);
  --text:#0f0824;
  --text-dim:#5a5070;
  --text-mute:#8f85ab;
}

body{
  font-family:"Poppins",sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
  line-height:1.5;
  transition:background .4s ease, color .4s ease;
}

/* Ambient background */
body::before{
  content:"";
  position:fixed;
  inset:0;
  background:
    radial-gradient(circle at 10% 0%, color-mix(in srgb, var(--accent) 15%, transparent) 0%, transparent 45%),
    radial-gradient(circle at 90% 10%, color-mix(in srgb, var(--primary) 10%, transparent) 0%, transparent 40%),
    radial-gradient(circle at 50% 100%, color-mix(in srgb, var(--accent-2) 10%, transparent) 0%, transparent 50%);
  pointer-events:none;
  z-index:-2;
  transition:background .6s ease;
}

body::after{
  content:"";
  position:fixed;
  inset:0;
  background-image:radial-gradient(circle, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size:36px 36px;
  pointer-events:none;
  z-index:-1;
  opacity:.7;
}

body.light::after{
  background-image:radial-gradient(circle, rgba(0,0,0,.04) 1px, transparent 1px);
}

/* ============ LAYOUT ============ */
.wrap{
  width:min(1400px, 94%);
  margin:0 auto;
  padding:20px 0 80px;
}

/* ============ TOP BAR ============ */
.top-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:14px;
  margin-bottom:24px;
  flex-wrap:wrap;
}

.brand{
  display:flex;
  flex-direction:column;
  gap:2px;
}

.brand-name{
  font-family:"Bebas Neue",sans-serif;
  font-size:2.2rem;
  letter-spacing:3px;
  line-height:1;
  background:linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  text-shadow:0 0 30px color-mix(in srgb, var(--primary) 30%, transparent);
}

.brand-tag{
  font-size:.6rem;
  letter-spacing:4px;
  text-transform:uppercase;
  color:var(--text-mute);
  font-weight:600;
}

.actions{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  align-items:center;
}

button{
  font-family:inherit;
  font-weight:600;
  border:none;
  cursor:pointer;
  transition:.25s cubic-bezier(.4,0,.2,1);
  border-radius:12px;
  outline:none;
}

.btn{
  padding:11px 16px;
  font-size:.8rem;
  background:var(--surface);
  color:var(--text);
  border:1px solid var(--border);
}

.btn:hover{
  border-color:var(--primary);
  color:var(--primary);
  transform:translateY(-1px);
}

.btn-primary{
  background:linear-gradient(135deg, var(--primary), var(--primary-2));
  color:#0a0614;
  border:none;
  font-weight:800;
  box-shadow:0 4px 20px color-mix(in srgb, var(--primary) 35%, transparent);
}

.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 28px color-mix(in srgb, var(--primary) 50%, transparent);
  color:#0a0614;
}

/* ============ HERO ============ */
.hero{
  position:relative;
  overflow:hidden;
  margin-bottom:28px;
  padding:48px 40px;
  border-radius:28px;
  background:
    linear-gradient(135deg,
      color-mix(in srgb, var(--surface) 95%, black) 0%,
      color-mix(in srgb, var(--surface-2) 85%, black) 100%);
  border:1px solid var(--border);
  box-shadow:0 20px 60px rgba(0,0,0,.35);
  isolation:isolate;
}

.hero::before{
  content:"";
  position:absolute;
  inset:-50%;
  background:conic-gradient(from 90deg,
    transparent 0 40%,
    var(--primary) 45%,
    transparent 52%,
    var(--accent) 65%,
    transparent 75%);
  filter:blur(90px);
  opacity:.18;
  z-index:-2;
  animation:spin 25s linear infinite;
}

.hero::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(90deg, rgba(0,0,0,.35), transparent 70%);
  z-index:-1;
  pointer-events:none;
}

body.light .hero::after{
  background:linear-gradient(90deg, rgba(255,255,255,.4), transparent 70%);
}

@keyframes spin{to{transform:rotate(360deg);}}

.hero-eyebrow{
  display:inline-block;
  padding:6px 14px;
  border-radius:999px;
  background:color-mix(in srgb, var(--primary) 12%, transparent);
  border:1px solid color-mix(in srgb, var(--primary) 30%, transparent);
  color:var(--primary);
  font-size:.65rem;
  letter-spacing:3px;
  font-weight:800;
  text-transform:uppercase;
  margin-bottom:16px;
}

.hero-title{
  font-family:"Bebas Neue",sans-serif;
  font-size:clamp(2.4rem, 6vw, 4.5rem);
  line-height:.95;
  letter-spacing:1px;
  margin-bottom:14px;
  color:var(--text);
}

.hero-title .accent{
  background:linear-gradient(90deg, var(--primary), var(--accent-2));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.hero-copy{
  max-width:600px;
  color:var(--text-dim);
  font-size:.9rem;
  line-height:1.7;
  margin-bottom:24px;
}

.hero-actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

/* ============ THEME PICKER ============ */
.theme-picker{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
  padding:14px 18px;
  margin-bottom:24px;
  border-radius:16px;
  background:var(--surface);
  border:1px solid var(--border);
}

.theme-picker-label{
  font-size:.65rem;
  letter-spacing:2px;
  text-transform:uppercase;
  color:var(--text-mute);
  font-weight:800;
  margin-right:6px;
}

.swatch{
  width:26px;
  height:26px;
  border-radius:50%;
  border:2px solid transparent;
  cursor:pointer;
  transition:.25s;
  position:relative;
}

.swatch:hover{transform:scale(1.15);}
.swatch.active{
  border-color:var(--text);
  box-shadow:0 0 0 3px color-mix(in srgb, var(--primary) 25%, transparent);
}

.swatch[data-accent="gold"]{background:linear-gradient(135deg,#ffb800,#ff8c42);}
.swatch[data-accent="cyan"]{background:linear-gradient(135deg,#06b6d4,#3b82f6);}
.swatch[data-accent="purple"]{background:linear-gradient(135deg,#a855f7,#ec4899);}
.swatch[data-accent="green"]{background:linear-gradient(135deg,#22c55e,#84cc16);}
.swatch[data-accent="red"]{background:linear-gradient(135deg,#ef4444,#f97316);}
.swatch[data-accent="pink"]{background:linear-gradient(135deg,#ec4899,#f472b6);}

/* ============ SEARCH ============ */
.search-area{
  position:relative;
  margin-bottom:26px;
  z-index:50;
}

.search-label{
  font-family:"Bebas Neue",sans-serif;
  font-size:1.3rem;
  letter-spacing:1px;
  color:var(--primary);
  margin-bottom:10px;
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}

.search-label small{
  font-family:"Poppins",sans-serif;
  font-size:.6rem;
  color:var(--text-mute);
  letter-spacing:1.5px;
  font-weight:600;
  text-transform:uppercase;
}

.search-input-wrap{
  position:relative;
  display:flex;
  align-items:center;
}

.search-input{
  width:100%;
  padding:20px 60px 20px 58px;
  font-family:inherit;
  font-size:1rem;
  font-weight:500;
  color:var(--text);
  background:var(--surface);
  border:2px solid var(--border);
  border-radius:18px;
  outline:none;
  transition:.3s;
  box-shadow:0 4px 20px rgba(0,0,0,.15);
}

.search-input::placeholder{color:var(--text-mute);}

.search-input:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 4px color-mix(in srgb, var(--primary) 15%, transparent);
}

.search-icon{
  position:absolute;
  left:22px;
  font-size:20px;
  pointer-events:none;
  opacity:.7;
}

.search-spinner{
  position:absolute;
  right:22px;
  width:20px;
  height:20px;
  border:2px solid var(--border);
  border-top-color:var(--primary);
  border-radius:50%;
  animation:spin .8s linear infinite;
  display:none;
}

.search-spinner.on{display:block;}

/* Dropdown */
.results-drop{
  position:absolute;
  top:calc(100% + 10px);
  left:0;right:0;
  max-height:520px;
  overflow-y:auto;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:18px;
  padding:8px;
  box-shadow:0 30px 70px rgba(0,0,0,.5);
  display:none;
  z-index:100;
}

.results-drop.open{display:block;animation:fadeDown .25s ease;}

@keyframes fadeDown{
  from{opacity:0;transform:translateY(-8px);}
  to{opacity:1;transform:translateY(0);}
}

.drop-header{
  padding:10px 14px 6px;
  font-size:.6rem;
  letter-spacing:2px;
  color:var(--text-mute);
  text-transform:uppercase;
  font-weight:800;
}

.result-item{
  display:flex;
  align-items:center;
  gap:14px;
  padding:10px;
  border-radius:12px;
  cursor:pointer;
  transition:.2s;
}

.result-item:hover,
.result-item.highlight{
  background:color-mix(in srgb, var(--primary) 8%, transparent);
}

.result-item img{
  width:52px;
  height:78px;
  object-fit:cover;
  border-radius:8px;
  flex-shrink:0;
  background:var(--surface-2);
  border:1px solid var(--border);
}

.result-info{flex:1;min-width:0;}

.result-info strong{
  display:block;
  font-size:.9rem;
  font-weight:600;
  color:var(--text);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.result-info small{
  display:block;
  margin-top:4px;
  font-size:.72rem;
  color:var(--text-dim);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.result-add{
  padding:8px 16px;
  font-size:.72rem;
  font-weight:800;
  border-radius:10px;
  background:linear-gradient(135deg, var(--primary), var(--primary-2));
  color:#0a0614;
  border:none;
  flex-shrink:0;
  white-space:nowrap;
}

.result-add:hover{transform:scale(1.05);}
.result-add:disabled{
  opacity:.45;
  cursor:not-allowed;
  transform:none;
}

.drop-empty,
.drop-loading{
  padding:36px 20px;
  text-align:center;
  color:var(--text-dim);
  font-size:.85rem;
}

.drop-loading{color:var(--primary);}

/* ============ STATS ============ */
.stats{
  display:grid;
  grid-template-columns:repeat(5, 1fr);
  gap:12px;
  margin-bottom:22px;
}

.stat{
  padding:18px 14px;
  border-radius:16px;
  background:var(--surface);
  border:1px solid var(--border);
  text-align:center;
  cursor:pointer;
  transition:.3s;
  position:relative;
  overflow:hidden;
}

.stat:hover{
  border-color:var(--primary);
  transform:translateY(-3px);
  box-shadow:0 8px 25px color-mix(in srgb, var(--primary) 15%, transparent);
}

.stat.active{
  border-color:var(--primary);
  background:color-mix(in srgb, var(--primary) 8%, var(--surface));
}

.stat-icon{font-size:22px;margin-bottom:6px;}
.stat-num{
  display:block;
  font-family:"Bebas Neue",sans-serif;
  font-size:1.8rem;
  letter-spacing:1px;
  line-height:1;
  color:var(--primary);
  margin-bottom:2px;
}
.stat-label{
  font-size:.6rem;
  letter-spacing:1.5px;
  text-transform:uppercase;
  color:var(--text-mute);
  font-weight:700;
}

/* ============ PROGRESS ============ */
.progress-bar-wrap{
  margin-bottom:22px;
  padding:18px 22px;
  border-radius:16px;
  background:var(--surface);
  border:1px solid var(--border);
}

.progress-meta{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:10px;
  font-size:.72rem;
}

.progress-meta .label{
  color:var(--text-dim);
  letter-spacing:1.5px;
  text-transform:uppercase;
  font-weight:700;
}

.progress-meta .value{
  color:var(--primary);
  font-weight:800;
  font-family:"Bebas Neue",sans-serif;
  font-size:1.1rem;
  letter-spacing:1px;
}

.progress-track{
  height:10px;
  background:var(--surface-2);
  border-radius:99px;
  overflow:hidden;
}

.progress-fill{
  height:100%;
  width:0%;
  background:linear-gradient(90deg, var(--primary), var(--accent));
  border-radius:99px;
  transition:width .6s cubic-bezier(.4,0,.2,1);
  box-shadow:0 0 15px color-mix(in srgb, var(--primary) 50%, transparent);
}

/* ============ FILTERS ============ */
.filters{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  align-items:center;
  margin-bottom:22px;
}

.chip{
  padding:9px 16px;
  border-radius:99px;
  background:var(--surface);
  border:1px solid var(--border);
  color:var(--text-dim);
  font-size:.74rem;
  font-weight:600;
  cursor:pointer;
  transition:.25s;
}

.chip:hover{
  color:var(--text);
  border-color:var(--primary);
}

.chip.active{
  background:linear-gradient(135deg, var(--primary), var(--primary-2));
  color:#0a0614;
  border-color:transparent;
  font-weight:800;
  box-shadow:0 4px 15px color-mix(in srgb, var(--primary) 30%, transparent);
}

.sort-wrap{margin-left:auto;}

.sort-select{
  padding:9px 14px;
  border-radius:10px;
  background:var(--surface);
  border:1px solid var(--border);
  color:var(--text);
  font-family:inherit;
  font-size:.74rem;
  font-weight:600;
  cursor:pointer;
  outline:none;
}

/* ============ MOVIE GRID ============ */
.movies{
  list-style:none;
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(190px, 1fr));
  gap:18px;
}

.movie{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:18px;
  overflow:hidden;
  cursor:pointer;
  transition:.35s cubic-bezier(.4,0,.2,1);
  position:relative;
}

.movie:hover{
  transform:translateY(-6px);
  border-color:var(--primary);
  box-shadow:0 20px 45px rgba(0,0,0,.4),
             0 0 30px color-mix(in srgb, var(--primary) 20%, transparent);
}

.movie-poster{
  position:relative;
  aspect-ratio:2/3;
  overflow:hidden;
  background:linear-gradient(135deg, var(--surface-2), var(--bg));
}

.movie-poster img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:.5s;
}

.movie:hover .movie-poster img{transform:scale(1.06);}

.movie-poster::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(to top, rgba(0,0,0,.9) 0%, transparent 50%);
  pointer-events:none;
}

.badge-status{
  position:absolute;
  top:10px;
  left:10px;
  padding:5px 10px;
  border-radius:8px;
  background:rgba(0,0,0,.75);
  backdrop-filter:blur(10px);
  border:1px solid color-mix(in srgb, var(--primary) 40%, transparent);
  color:var(--primary);
  font-size:.55rem;
  font-weight:800;
  letter-spacing:1px;
  text-transform:uppercase;
  z-index:2;
}

.btn-fav{
  position:absolute;
  top:10px;
  right:10px;
  width:34px;
  height:34px;
  border-radius:50%;
  background:rgba(0,0,0,.7);
  backdrop-filter:blur(10px);
  color:#fff;
  font-size:15px;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:2;
  border:1px solid rgba(255,255,255,.15);
}

.btn-fav:hover{
  background:var(--danger);
  transform:scale(1.12);
}

.btn-fav.on{
  color:var(--danger);
  background:rgba(255,255,255,.95);
}

.movie-body{padding:14px;}

.movie-title{
  font-size:.85rem;
  font-weight:600;
  line-height:1.4;
  min-height:2.5em;
  margin-bottom:10px;
  color:var(--text);
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

.movie-meta{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
}

.tag{
  padding:4px 8px;
  border-radius:6px;
  background:var(--surface-2);
  border:1px solid var(--border);
  color:var(--text-dim);
  font-size:.6rem;
  font-weight:600;
}

.tag.rating{
  color:var(--primary);
  border-color:color-mix(in srgb, var(--primary) 35%, transparent);
  background:color-mix(in srgb, var(--primary) 8%, var(--surface-2));
}

/* ============ EMPTY ============ */
.empty{
  grid-column:1/-1;
  padding:70px 24px;
  text-align:center;
  border:2px dashed var(--border);
  border-radius:20px;
  background:var(--surface);
}

.empty-icon{
  font-size:56px;
  opacity:.35;
  margin-bottom:18px;
}

.empty h3{
  font-family:"Bebas Neue",sans-serif;
  font-size:1.6rem;
  letter-spacing:1px;
  margin-bottom:8px;
}

.empty p{
  color:var(--text-dim);
  font-size:.85rem;
  max-width:400px;
  margin:0 auto;
  line-height:1.6;
}

/* ============ MODAL ============ */
.modal{
  position:fixed;
  inset:0;
  z-index:999;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:rgba(5,3,12,.88);
  backdrop-filter:blur(15px);
  opacity:0;
  visibility:hidden;
  transition:.35s;
}

.modal.on{opacity:1;visibility:visible;}

.modal-box{
  width:min(900px, 96vw);
  max-height:90vh;
  overflow-y:auto;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:24px;
  padding:26px;
  box-shadow:0 40px 100px rgba(0,0,0,.6);
  transform:translateY(30px) scale(.95);
  transition:transform .4s cubic-bezier(.4,0,.2,1);
  position:relative;
}

.modal.on .modal-box{transform:translateY(0) scale(1);}

.modal-wide{
  display:grid;
  grid-template-columns:280px 1fr;
  gap:26px;
}

.modal-poster{
  width:100%;
  aspect-ratio:2/3;
  object-fit:cover;
  border-radius:14px;
  border:1px solid var(--border);
  background:var(--surface-2);
}

.modal-content-col{display:flex;flex-direction:column;min-width:0;}

.modal-close{
  position:absolute;
  top:16px;
  right:16px;
  width:38px;
  height:38px;
  border-radius:50%;
  background:var(--surface-2);
  border:1px solid var(--border);
  color:var(--text);
  font-size:18px;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:5;
}

.modal-close:hover{background:var(--danger);color:#fff;transform:rotate(90deg);}

.modal-title{
  font-family:"Bebas Neue",sans-serif;
  font-size:2rem;
  letter-spacing:1px;
