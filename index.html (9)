<script>
/* ==========================================================================
   CINEVAULT -- Complete Working Application
   --------------------------------------------------------------------------
   🔑 STEP 1: Paste your TMDB API key below (optional but recommended)
              Get free key: https://www.themoviedb.org/settings/api
              Without key → app uses iTunes API (still works)
   ========================================================================== */

const TMDB_KEY = "bcd1f010c0ef58b759dae2f30cfb7314";  /* ⬅️ PASTE YOUR TMDB v3 API KEY INSIDE THE QUOTES */

/* ==========================================================================
   END OF CONFIG -- Do not change below unless you know what you're doing
   ========================================================================== */

(function(){
"use strict";

/* ---------- STATE ---------- */
let vault = [];
let collections = [];
let currentFilter = "all";
let currentSort = "recent";
let currentQuery = "";
let searchResults = [];
let searchTimeout = null;
let highlightIdx = -1;
let modalId = null;
let editingId = null;

/* ---------- ELEMENTS ---------- */
const $ = id => document.getElementById(id);
const TMDB_READY = TMDB_KEY && TMDB_KEY.length > 20 && !TMDB_KEY.startsWith("PASTE_");

/* ---------- STORAGE KEYS ---------- */
const K_VAULT = "cv_vault_v3";
const K_THEME = "cv_theme_v3";
const K_MODE  = "cv_mode_v3";

/* ---------- UTIL ---------- */
function esc(s){
  return String(s == null ? "" : s).replace(/[&<>"']/g, c =>
    ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

function toast(msg, isErr){
  const t = $("toast");
  t.textContent = msg;
  t.classList.toggle("err", !!isErr);
  t.classList.add("on");
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove("on"), 2400);
}

function saveVault(){
  try{ localStorage.setItem(K_VAULT, JSON.stringify(vault)); }catch(e){}
}
function loadVault(){
  try{
    const raw = localStorage.getItem(K_VAULT);
    vault = raw ? JSON.parse(raw) : [];
    if(!Array.isArray(vault)) vault = [];
  }catch(e){ vault = []; }
}

function imgFallback(img, title){
  img.onerror = function(){
    this.onerror = null;
    const t = encodeURIComponent(title || "Movie");
    this.src = "https://placehold.co/300x450/1a1030/ffb800?text=" + t;
  };
}

/* ==========================================================================
   SEARCH -- TMDB (primary) + iTunes (fallback)
   ========================================================================== */

async function searchTMDB(query){
  if(!TMDB_READY) return null;
  try{
    const url = "https://api.themoviedb.org/3/search/movie?api_key=" +
                TMDB_KEY +
                "&query=" + encodeURIComponent(query) +
                "&include_adult=false&language=en-US&page=1";
    const res = await fetch(url);
    if(!res.ok) return null;
    const data = await res.json();
    if(!data.results || !data.results.length) return [];
    return data.results.slice(0, 12).map(m => ({
      source: "tmdb",
      sourceId: "tmdb-" + m.id,
      tmdbId: m.id,
      title: m.title || m.original_title || "Untitled",
      year: (m.release_date || "").slice(0,4) || "--",
      releaseDate: m.release_date || "",
      poster: m.poster_path ? "https://image.tmdb.org/t/p/w500" + m.poster_path : "",
      backdrop: m.backdrop_path ? "https://image.tmdb.org/t/p/w780" + m.backdrop_path : "",
      overview: m.overview || "",
      rating: m.vote_average || 0,
      genre: "",
      runtime: 0
    }));
  }catch(e){
    console.warn("TMDB search failed:", e);
    return null;
  }
}

async function searchiTunes(query){
  try{
    const url = "https://itunes.apple.com/search?term=" + encodeURIComponent(query) +
                "&media=movie&entity=movie&limit=12";
    const res = await fetch(url);
    if(!res.ok) throw new Error("iTunes failed");
    const data = await res.json();
    return (data.results || []).map(m => {
      const poster = m.artworkUrl100
        ? m.artworkUrl100.replace("100x100bb", "600x900bb")
        : "";
      const releaseDate = m.releaseDate ? m.releaseDate.slice(0,10) : "";
      return {
        source: "itunes",
        sourceId: "itunes-" + m.trackId,
        title: m.trackName || "Untitled",
        year: releaseDate ? releaseDate.slice(0,4) : "--",
        releaseDate,
        poster,
        backdrop: "",
        overview: m.longDescription || m.shortDescription || "",
        rating: 0,
        genre: m.primaryGenreName || "",
        runtime: m.trackTimeMillis ? Math.round(m.trackTimeMillis / 60000) : 0
      };
    });
  }catch(e){
    console.error("iTunes search error:", e);
    return [];
  }
}

async function searchMovies(query){
  const tmdb = await searchTMDB(query);
  if(tmdb !== null && tmdb.length > 0) return tmdb;
  return searchiTunes(query);
}

/* Fetch full details from TMDB when adding */
async function fetchDetails(tmdbId){
  if(!TMDB_READY || !tmdbId) return null;
  try{
    const [detailsR, creditsR, videosR] = await Promise.all([
      fetch(`https://api.themoviedb.org/3/movie/${tmdbId}?api_key=${TMDB_KEY}`),
      fetch(`https://api.themoviedb.org/3/movie/${tmdbId}/credits?api_key=${TMDB_KEY}`),
      fetch(`https://api.themoviedb.org/3/movie/${tmdbId}/videos?api_key=${TMDB_KEY}`)
    ]);
    const details = detailsR.ok ? await detailsR.json() : null;
    const credits = creditsR.ok ? await creditsR.json() : null;
    const videos = videosR.ok ? await videosR.json() : null;

    let trailer = "";
    if(videos && videos.results){
      const yt = videos.results.find(v => v.site === "YouTube" && v.type === "Trailer");
      if(yt) trailer = "https://www.youtube.com/watch?v=" + yt.key;
    }
    let cast = [];
    if(credits && credits.cast){
      cast = credits.cast.slice(0, 8).map(c => c.name);
    }
    return {
      runtime: details?.runtime || 0,
      genre: details?.genres?.map(g => g.name).join(", ") || "",
      overview: details?.overview || "",
      tmdbRating: details?.vote_average || 0,
      trailerUrl: trailer,
      cast: cast,
      director: credits?.crew?.find(c => c.job === "Director")?.name || ""
    };
  }catch(e){
    console.warn("TMDB details failed:", e);
    return null;
  }
}

/* ==========================================================================
   SEARCH DROPDOWN
   ========================================================================== */

function renderDropdown(query){
  const dd = $("resultsDrop");
  const sp = $("searchSpinner");

  if(!query || query.trim().length < 2){
    dd.classList.remove("open");
    dd.innerHTML = "";
    sp.classList.remove("on");
    return;
  }

  dd.classList.add("open");
  dd.innerHTML = '<div class="drop-loading">🔍 Searching "' + esc(query) + '"...</div>';
  sp.classList.add("on");

  searchMovies(query).then(results => {
    sp.classList.remove("on");
    searchResults = results;
    highlightIdx = -1;

    if(!results || results.length === 0){
      dd.innerHTML =
        '<div class="drop-empty">' +
          '<div style="font-size:38px;margin-bottom:10px;opacity:.4">🎬</div>' +
          '<div>No movies found for "<b>' + esc(query) + '</b>"</div>' +
          '<div style="margin-top:8px;font-size:.72rem;color:var(--text-mute)">Try a different spelling or add manually.</div>' +
        '</div>';
      return;
    }

    const inVault = new Set(vault.map(v => v.sourceId));

    let html = '<div class="drop-header">Found ' + results.length + ' results</div>';
    results.forEach((m, i) => {
      const added = inVault.has(m.sourceId);
      html +=
        '<div class="result-item" data-idx="' + i + '">' +
          '<img src="' + esc(m.poster) + '" alt="" onerror="this.src=\'https://placehold.co/60x90/1a1030/ffb800?text=?\'">' +
          '<div class="result-info">' +
            '<strong>' + esc(m.title) + '</strong>' +
            '<small>' + esc(m.year) +
              (m.genre ? ' • ' + esc(m.genre) : '') +
              (m.rating ? ' • ⭐ ' + Number(m.rating).toFixed(1) : '') +
            '</small>' +
          '</div>' +
          '<button class="result-add" data-add="' + i + '"' +
            (added ? ' disabled' : '') + '>' +
            (added ? '✓ Added' : '+ Add') +
          '</button>' +
        '</div>';
    });
    dd.innerHTML = html;
  }).catch(err => {
    sp.classList.remove("on");
    console.error(err);
    dd.innerHTML = '<div class="drop-empty" style="color:#ff7b7b">Search failed. Check your internet connection.</div>';
  });
}

/* ==========================================================================
   ADD MOVIE
   ========================================================================== */

async function addMovieFromResult(result){
  if(!result) return;

  const exists = vault.find(v =>
    v.sourceId === result.sourceId ||
    (v.title.toLowerCase() === result.title.toLowerCase() && v.year === result.year)
  );
  if(exists){
    toast("Already in your vault", true);
    return;
  }

  let extra = {};
  if(result.source === "tmdb" && result.tmdbId){
    toast("⏳ Fetching full details...");
    const details = await fetchDetails(result.tmdbId);
    if(details) extra = details;
  }

  const movie = {
    id: "cv-" + Date.now() + "-" + Math.random().toString(36).slice(2,7),
    sourceId: result.sourceId,
    tmdbId: result.tmdbId || null,
    title: result.title,
    year: result.year || "--",
    releaseDate: result.releaseDate || "",
    poster: result.poster || "",
    backdrop: result.backdrop || "",
    overview: extra.overview || result.overview || "",
    tmdbRating: extra.tmdbRating || Number(result.rating) || 0,
    genre: extra.genre || result.genre || "",
    runtime: extra.runtime || result.runtime || 0,
    cast: extra.cast || [],
    director: extra.director || "",
    trailerUrl: extra.trailerUrl || "",
    watchUrl: "",
    downloadUrl: "",
    userRating: 0,
    notes: "",
    status: "want",
    favorite: false,
    addedAt: Date.now(),
    watchedAt: null
  };

  vault.unshift(movie);
  saveVault();
  renderAll();
  toast("✓ " + movie.title + " added to vault");
}

/* ==========================================================================
   RENDER
   ========================================================================== */

function getFiltered(){
  let list = vault.slice();

  if(currentFilter === "favorites"){
    list = list.filter(m => m.favorite);
  }else if(currentFilter !== "all"){
    list = list.filter(m => m.status === currentFilter);
  }

  if(currentQuery.length >= 2){
    const q = currentQuery.toLowerCase();
    list = list.filter(m =>
      (m.title || "").toLowerCase().includes(q) ||
      (m.year || "").includes(q) ||
      (m.genre || "").toLowerCase().includes(q)
    );
  }

  if(currentSort === "recent"){
    list.sort((a,b) => (b.addedAt||0) - (a.addedAt||0));
  }else if(currentSort === "title"){
    list.sort((a,b) => a.title.localeCompare(b.title));
  }else if(currentSort === "year"){
    list.sort((a,b) => (parseInt(b.year)||0) - (parseInt(a.year)||0));
  }else if(currentSort === "rating"){
    list.sort((a,b) => (b.userRating||0) - (a.userRating||0));
  }else if(currentSort === "tmdb"){
    list.sort((a,b) => (b.tmdbRating||0) - (a.tmdbRating||0));
  }

  return list;
}

function renderMovies(){
  const list = $("moviesList");
  const filtered = getFiltered();

  if(filtered.length === 0){
    list.innerHTML =
      '<li class="empty">' +
        '<div class="empty-icon">🎬</div>' +
        '<h3>' + (vault.length === 0 ? "Your vault is empty" : "No matches") + '</h3>' +
        '<p>' +
          (vault.length === 0
            ? "Search any movie above and click '+ Add' to start building your collection."
            : "Try changing filters or search term.") +
        '</p>' +
      '</li>';
    return;
  }

  list.innerHTML = "";

  filtered.forEach(m => {
    const li = document.createElement("li");
    li.className = "movie";
    li.dataset.id = m.id;

    const statusLabel = {
      want: "🎯 Want",
      watching: "▶️ Watching",
      watched: "✅ Watched",
      dropped: "⏸️ Dropped"
    }[m.status] || "🎯 Want";

    li.innerHTML =
      '<div class="movie-poster">' +
        '<img src="' + esc(m.poster) + '" alt="' + esc(m.title) + '" loading="lazy">' +
        '<div class="badge-status">' + statusLabel + '</div>' +
        '<button class="btn-fav ' + (m.favorite ? "on" : "") + '" data-fav="' + m.id + '">' +
          (m.favorite ? "❤️" : "♡") +
        '</button>' +
      '</div>' +
      '<div class="movie-body">' +
        '<h3 class="movie-title">' + esc(m.title) + '</h3>' +
        '<div class="movie-meta">' +
          '<span class="tag">📅 ' + esc(m.year || "--") + '</span>' +
          (m.tmdbRating ? '<span class="tag rating">⭐ ' + Number(m.tmdbRating).toFixed(1) + '</span>' : '') +
          (m.userRating ? '<span class="tag rating">🌟 ' + m.userRating + '</span>' : '') +
        '</div>' +
      '</div>';

    const img = li.querySelector("img");
    imgFallback(img, m.title);

    li.addEventListener("click", e => {
      if(e.target.closest("button")) return;
      openModal(m.id);
    });

    li.querySelector("[data-fav]").addEventListener("click", e => {
      e.stopPropagation();
      toggleFav(m.id);
    });

    list.appendChild(li);
  });
}

function updateStats(){
  const total = vault.length;
  const want = vault.filter(m => m.status === "want").length;
  const watching = vault.filter(m => m.status === "watching").length;
  const watched = vault.filter(m => m.status === "watched").length;
  const favs = vault.filter(m => m.favorite).length;

  $("statTotal").textContent = total;
  $("statWant").textContent = want;
  $("statWatching").textContent = watching;
  $("statWatched").textContent = watched;
  $("statFav").textContent = favs;

  const pct = total > 0 ? Math.round((watched / total) * 100) : 0;
  $("progressFill").style.width = pct + "%";
  $("progressValue").textContent = watched + " / " + total + " (" + pct + "%)";
}

function renderAll(){
  renderMovies();
  updateStats();
}

/* ==========================================================================
   FAVORITE / STATUS
   ========================================================================== */

function toggleFav(id){
  const m = vault.find(v => v.id === id);
  if(!m) return;
  m.favorite = !m.favorite;
  saveVault();
  renderAll();
  toast(m.favorite ? "❤️ Added to favorites" : "Removed from favorites");
  if(modalId === id) syncModalFav(id);
}

function syncModalFav(id){
  const m = vault.find(v => v.id === id);
  if(!m) return;
  $("btnFav").textContent = m.favorite ? "❤️ Favorited" : "♡ Favorite";
}

function setStatus(id, status){
  const m = vault.find(v => v.id === id);
  if(!m) return;
  m.status = status;
  if(status === "watched" && !m.watchedAt) m.watchedAt = Date.now();
  saveVault();
  renderAll();
  if(modalId === id) syncModalStatus();
}

function syncModalStatus(){
  const m = vault.find(v => v.id === modalId);
  if(!m) return;
  document.querySelectorAll(".status-pick").forEach(b => {
    b.classList.toggle("on", b.dataset.status === m.status);
  });
}

/* ==========================================================================
   MODAL
   ========================================================================== */

function openModal(id){
  const m = vault.find(v => v.id === id);
  if(!m) return;
  modalId = id;

  $("mPoster").src = m.poster || "";
  $("mPoster").onerror = function(){
    this.onerror = null;
    this.src = "https://placehold.co/300x450/1a1030/ffb800?text=" + encodeURIComponent(m.title);
  };
  $("mTitle").textContent = m.title;

  let tags = '<span class="tag">📅 ' + esc(m.year || "--") + '</span>';
  if(m.tmdbRating) tags += '<span class="tag rating">⭐ TMDB ' + Number(m.tmdbRating).toFixed(1) + '</span>';
  if(m.genre) tags += '<span class="tag">🎭 ' + esc(m.genre) + '</span>';
  if(m.runtime) tags += '<span class="tag">⏱️ ' + m.runtime + ' min</span>';
  if(m.director) tags += '<span class="tag">🎬 ' + esc(m.director) + '</span>';
  $("mTags").innerHTML = tags;

  $("mDesc").textContent = m.overview || "No description available.";

  document.querySelectorAll(".status-pick").forEach(b => {
    b.classList.toggle("on", b.dataset.status === m.status);
  });

  $("btnFav").textContent = m.favorite ? "❤️ Favorited" : "♡ Favorite";
  $("btnTrailer").style.display = m.trailerUrl ? "" : "none";
  $("btnWatch").style.display = m.watchUrl ? "" : "none";
  $("btnDownload").style.display = m.downloadUrl ? "" : "none";
  $("mNote").value = m.notes || "";

  $("movieModal").classList.add("on");
  document.body.style.overflow = "hidden";
}

function closeModal(){
  $("movieModal").classList.remove("on");
  document.body.style.overflow = "";
  modalId = null;
}

/* ==========================================================================
   EDIT MODAL
   ========================================================================== */

function openEdit(id){
  editingId = id || null;
  $("editTitle").textContent = id ? "Edit Movie" : "Add Movie";

  let data = {title:"",year:"",genre:"",poster:"",overview:"",trailerUrl:"",watchUrl:"",downloadUrl:"",userRating:""};

  if(id){
    const m = vault.find(v => v.id === id);
    if(m) data = {
      title: m.title || "",
      year: m.year || "",
      genre: m.genre || "",
      poster: m.poster || "",
      overview: m.overview || "",
      trailerUrl: m.trailerUrl || "",
      watchUrl: m.watchUrl || "",
      downloadUrl: m.downloadUrl || "",
      userRating: m.userRating || ""
    };
  }

  $("fTitle").value = data.title;
  $("fYear").value = data.year === "--" ? "" : data.year;
  $("fGenre").value = data.genre;
  $("fPoster").value = data.poster;
  $("fOverview").value = data.overview;
  $("fTrailer").value = data.trailerUrl;
  $("fWatch").value = data.watchUrl;
  $("fDownload").value = data.downloadUrl;
  $("fRating").value = data.userRating;

  $("editModal").classList.add("on");
  document.body.style.overflow = "hidden";
}

function closeEdit(){
  $("editModal").classList.remove("on");
  document.body.style.overflow = "";
  editingId = null;
}

/* ==========================================================================
   EVENTS -- SEARCH
   ========================================================================== */

$("searchInput").addEventListener("input", e => {
  const q = e.target.value;
  currentQuery = q;
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => renderDropdown(q), 350);
  renderMovies();
});

$("searchInput").addEventListener("keydown", e => {
  const items = $("resultsDrop").querySelectorAll(".result-item");
  if(!items.length) return;

  if(e.key === "ArrowDown"){
    e.preventDefault();
    highlightIdx = Math.min(highlightIdx + 1, items.length - 1);
    updateHighlight(items);
  }else if(e.key === "ArrowUp"){
    e.preventDefault();
    highlightIdx = Math.max(highlightIdx - 1, 0);
    updateHighlight(items);
  }else if(e.key === "Enter" && highlightIdx >= 0 && searchResults[highlightIdx]){
    e.preventDefault();
    addMovieFromResult(searchResults[highlightIdx]);
    closeDropdown();
  }else if(e.key === "Escape"){
    closeDropdown();
  }
});

function updateHighlight(items){
  items.forEach((el, i) => el.classList.toggle("highlight", i === highlightIdx));
  if(items[highlightIdx]) items[highlightIdx].scrollIntoView({block:"nearest"});
}

function closeDropdown(){
  $("resultsDrop").classList.remove("open");
  $("resultsDrop").innerHTML = "";
  searchResults = [];
  highlightIdx = -1;
}

/* Dropdown click */
$("resultsDrop").addEventListener("click", e => {
  const addBtn = e.target.closest("[data-add]");
  if(addBtn){
    e.stopPropagation();
    const idx = parseInt(addBtn.dataset.add, 10);
    addMovieFromResult(searchResults[idx]);
    addBtn.textContent = "✓ Added";
    addBtn.disabled = true;
    return;
  }
  const item = e.target.closest("[data-idx]");
  if(item){
    const idx = parseInt(item.dataset.idx, 10);
    addMovieFromResult(searchResults[idx]);
    closeDropdown();
  }
});

/* Close dropdown on outside click */
document.addEventListener("click", e => {
  if(!e.target.closest("#searchArea")) closeDropdown();
});

/* ==========================================================================
   EVENTS -- FILTERS
   ========================================================================== */

document.querySelectorAll(".chip").forEach(chip => {
  chip.addEventListener("click", () => {
    document.querySelectorAll(".chip").forEach(c => c.classList.remove("active"));
    chip.classList.add("active");
    currentFilter = chip.dataset.chip;

    document.querySelectorAll(".stat").forEach(s => {
      s.classList.toggle("active", s.dataset.filter === currentFilter);
    });
    renderMovies();
  });
});

document.querySelectorAll(".stat").forEach(stat => {
  stat.addEventListener("click", () => {
    const f = stat.dataset.filter;
    document.querySelectorAll(".stat").forEach(s => s.classList.remove("active"));
    stat.classList.add("active");
    document.querySelectorAll(".chip").forEach(c => {
      c.classList.toggle("active", c.dataset.chip === f);
    });
    currentFilter = f;
    renderMovies();
  });
});

$("sortSelect").addEventListener("change", e => {
  currentSort = e.target.value;
  renderMovies();
});

/* ==========================================================================
   EVENTS -- MODAL
   ========================================================================== */

$("modalClose").addEventListener("click", closeModal);
$("movieModal").addEventListener("click", e => {
  if(e.target === $("movieModal")) closeModal();
});

document.querySelectorAll(".status-pick").forEach(btn => {
  btn.addEventListener("click", () => {
    if(modalId) setStatus(modalId, btn.dataset.status);
  });
});

$("btnFav").addEventListener("click", () => {
  if(modalId) toggleFav(modalId);
});

$("btnTrailer").addEventListener("click", () => {
  const m = vault.find(v => v.id === modalId);
  if(m && m.trailerUrl) window.open(m.trailerUrl, "_blank", "noopener");
});

$("btnWatch").addEventListener("click", () => {
  const m = vault.find(v => v.id === modalId);
  if(m && m.watchUrl) window.open(m.watchUrl, "_blank", "noopener");
});

$("btnDownload").addEventListener("click", () => {
  const m = vault.find(v => v.id === modalId);
  if(m && m.downloadUrl) window.open(m.downloadUrl, "_blank", "noopener");
});

$("btnEdit").addEventListener("click", () => {
  if(!modalId) return;
  const id = modalId;
  closeModal();
  openEdit(id);
});

$("btnDelete").addEventListener("click", () => {
  if(!modalId) return;
  if(!confirm("Delete this movie from your vault?")) return;
  vault = vault.filter(v => v.id !== modalId);
  saveVault();
  renderAll();
  closeModal();
  toast("Movie deleted");
});

/* Notes auto-save */
let noteTimer;
$("mNote").addEventListener("input", () => {
  clearTimeout(noteTimer);
  noteTimer = setTimeout(() => {
    const m = vault.find(v => v.id === modalId);
    if(!m) return;
    m.notes = $("mNote").value;
    saveVault();
  }, 600);
});

/* ==========================================================================
   EVENTS -- EDIT MODAL
   ========================================================================== */

$("editClose").addEventListener("click", closeEdit);
$("editCancel").addEventListener("click", closeEdit);
$("editModal").addEventListener("click", e => {
  if(e.target === $("editModal")) closeEdit();
});

$("editForm").addEventListener("submit", e => {
  e.preventDefault();

  const payload = {
    title: $("fTitle").value.trim(),
    year: $("fYear").value.trim(),
    genre: $("fGenre").value.trim(),
    poster: $("fPoster").value.trim(),
    overview: $("fOverview").value.trim(),
    trailerUrl: $("fTrailer").value.trim(),
    watchUrl: $("fWatch").value.trim(),
    downloadUrl: $("fDownload").value.trim(),
    userRating: parseFloat($("fRating").value) || 0
  };

  if(!payload.title){
    toast("Title is required", true);
    return;
  }

  if(editingId){
    const m = vault.find(v => v.id === editingId);
    if(m){
      Object.assign(m, {
        title: payload.title,
        year: payload.year || m.year || "--",
        genre: payload.genre || m.genre,
        poster: payload.poster || m.poster,
        overview: payload.overview || m.overview,
        trailerUrl: payload.trailerUrl,
        watchUrl: payload.watchUrl,
        downloadUrl: payload.downloadUrl,
        userRating: payload.userRating
      });
    }
    toast("✓ Movie updated");
  }else{
    vault.unshift({
      id: "cv-manual-" + Date.now(),
      sourceId: "manual-" + Date.now(),
      tmdbId: null,
      title: payload.title,
      year: payload.year || "--",
      releaseDate: "",
      poster: payload.poster,
      backdrop: "",
      overview: payload.overview,
      tmdbRating: 0,
      genre: payload.genre,
      runtime: 0,
      cast: [],
      director: "",
      trailerUrl: payload.trailerUrl,
      watchUrl: payload.watchUrl,
      downloadUrl: payload.downloadUrl,
      userRating: payload.userRating,
      notes: "",
      status: "want",
      favorite: false,
      addedAt: Date.now(),
      watchedAt: null
    });
    toast("✓ Movie added to vault");
  }

  saveVault();
  renderAll();
  closeEdit();
});

$("manualBtn").addEventListener("click", () => openEdit(null));

/* ==========================================================================
   EVENTS -- THEME
   ========================================================================== */

document.querySelectorAll(".swatch").forEach(sw => {
  sw.addEventListener("click", () => {
    const accent = sw.dataset.accent;
    document.body.dataset.accent = accent;
    document.querySelectorAll(".swatch").forEach(s => s.classList.remove("active"));
    sw.classList.add("active");
    try{ localStorage.setItem(K_THEME, accent); }catch(e){}
  });
});

$("themeToggle").addEventListener("click", () => {
  document.body.classList.toggle("light");
  const light = document.body.classList.contains("light");
  $("themeToggle").textContent = light ? "☀️ Light" : "🌙 Dark";
  try{ localStorage.setItem(K_MODE, light ? "1" : "0"); }catch(e){}
});

/* ==========================================================================
   EVENTS -- HERO
   ========================================================================== */

$("heroSearchBtn").addEventListener("click", () => {
  $("searchArea").scrollIntoView({behavior:"smooth", block:"center"});
  setTimeout(() => $("searchInput").focus(), 400);
});

$("heroVaultBtn").addEventListener("click", () => {
  $("moviesList").scrollIntoView({behavior:"smooth", block:"start"});
});

/* ==========================================================================
   KEYBOARD
   ========================================================================== */

document.addEventListener("keydown", e => {
  if(e.key === "/" && document.activeElement !== $("searchInput")){
    e.preventDefault();
    $("searchInput").focus();
  }
  if(e.key === "Escape"){
    if($("movieModal").classList.contains("on")) closeModal();
    else if($("editModal").classList.contains("on")) closeEdit();
    else closeDropdown();
  }
});

/* ==========================================================================
   INIT
   ========================================================================== */

function init(){
  loadVault();

  // Restore theme accent
  try{
    const accent = localStorage.getItem(K_THEME) || "gold";
    document.body.dataset.accent = accent;
    document.querySelectorAll(".swatch").forEach(s => {
      s.classList.toggle("active", s.dataset.accent === accent);
    });
  }catch(e){}

  // Restore light mode
  try{
    if(localStorage.getItem(K_MODE) === "1"){
      document.body.classList.add("light");
      $("themeToggle").textContent = "☀️ Light";
    }
  }catch(e){}

  // Update search source label
  $("searchSource").textContent = TMDB_READY
    ? "✓ TMDB (Full Details)"
    : "iTunes Free Search (Add TMDB key for more details)";

  renderAll();

  console.log("🎬 CineVault ready -- " + vault.length + " movies in vault");
  console.log("🔍 Search source: " + (TMDB_READY ? "TMDB" : "iTunes"));
  if(!TMDB_READY){
    console.log("💡 Tip: Add your TMDB API key in the file to get cast, trailers, runtime automatically.");
  }
}

init();

})();
