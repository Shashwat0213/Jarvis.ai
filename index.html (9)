<script>
/* =========================================================
   CINEVAULT -- PART 2: CORE JAVASCRIPT
   Universal search via iTunes API (free, no key needed)
   + TMDB optional support
   + Full watchlist management with localStorage
========================================================= */

(function(){
"use strict";

/* =========================================================
   CONFIG
========================================================= */
const CONFIG = {
  // Optional: paste your TMDB API key here for richer data
  // Free key: https://www.themoviedb.org/settings/api
  TMDB_KEY: "",
  
  STORAGE: {
    VAULT: "cinevault_movies",
    ACCENT: "cinevault_accent",
    LIGHT: "cinevault_light"
  }
};

/* =========================================================
   STATE
========================================================= */
let vault = [];
let currentFilter = "all";
let currentSort = "added";
let currentSearch = "";
let searchResults = [];
let searchDebounceTimer = null;
let activeSearchIndex = -1;
let modalMovieId = null;

/* =========================================================
   ELEMENTS
========================================================= */
const $ = id => document.getElementById(id);

const movieList       = $("movieList");
const universalSearch = $("universalSearch");
const searchDropdown  = $("searchDropdown");
const searchClear     = $("searchClear");
const themeBtn        = $("themeBtn");
const sortSelect      = $("sortSelect");
const filterBtns      = document.querySelectorAll(".filter-btn");
const statCards       = document.querySelectorAll(".stat-card");
const themeChoices    = document.querySelectorAll(".theme-choice");

const statTotal    = $("statTotal");
const statWant     = $("statWant");
const statWatching = $("statWatching");
const statWatched  = $("statWatched");
const statFav      = $("statFav");
const progressBar  = $("progressBar");
const progressText = $("progressText");

const movieModal   = $("movieModal");
const modalClose   = $("modalClose");
const modalPoster  = $("modalPoster");
const modalTitle   = $("modalTitle");
const modalMeta    = $("modalMeta");
const modalDesc    = $("modalDescription");
const modalTrailer = $("modalTrailerBtn");
const modalWatch   = $("modalWatchBtn");
const modalDownload= $("modalDownloadBtn");
const modalFavBtn  = $("modalFavBtn");
const statusBtns   = document.querySelectorAll(".status-btn");
const userNote     = $("userNote");

const toast = $("toast");

/* =========================================================
   STORAGE
========================================================= */
function saveVault(){
  try{
    localStorage.setItem(CONFIG.STORAGE.VAULT, JSON.stringify(vault));
  }catch(e){ console.warn("Save failed:", e); }
}

function loadVault(){
  try{
    const raw = localStorage.getItem(CONFIG.STORAGE.VAULT);
    vault = raw ? JSON.parse(raw) : [];
    if(!Array.isArray(vault)) vault = [];
  }catch(e){
    vault = [];
  }
}

/* =========================================================
   TOAST
========================================================= */
let toastTimer = null;
function showToast(message, type){
  if(!toast) return;
  toast.textContent = message;
  toast.style.background = (type === "error")
    ? "linear-gradient(135deg,#ef4444,#dc2626)"
    : "linear-gradient(135deg,#ffb800,#ff8c42)";
  toast.style.color = (type === "error") ? "#fff" : "#0a0710";
  toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove("show"), 2600);
}

/* =========================================================
   UTILITIES
========================================================= */
function escapeHtml(s){
  return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({
    "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;"
  }[c]));
}
function escapeAttr(s){ return escapeHtml(s); }

function posterFallback(img){
  img.onerror = function(){
    this.onerror = null;
    var label = encodeURIComponent(this.dataset.title || "Movie");
    this.src = "https://placehold.co/300x450/1c1332/ffb800?text=" + label;
  };
}

/* =========================================================
   SEARCH -- iTunes Search API (free, no key required)
========================================================= */
async function searchMovies(query){
  if(!query || query.trim().length < 2) return [];
  var q = query.trim();

  // 1. Try TMDB if key is provided
  if(CONFIG.TMDB_KEY){
    try{
      var tmdbUrl = "https://api.themoviedb.org/3/search/movie?api_key=" +
        CONFIG.TMDB_KEY +
        "&query=" + encodeURIComponent(q) +
        "&include_adult=false&language=en-US&page=1";
      var tmdbRes = await fetch(tmdbUrl);
      if(tmdbRes.ok){
        var tmdbData = await tmdbRes.json();
        if(tmdbData.results && tmdbData.results.length){
          return tmdbData.results.slice(0, 10).map(function(m){
            return {
              source: "tmdb",
              sourceId: "tmdb-" + m.id,
              title: m.title || "Untitled",
              year: (m.release_date || "").slice(0,4) || "--",
              releaseDate: m.release_date || "",
              poster: m.poster_path
                ? "https://image.tmdb.org/t/p/w500" + m.poster_path
                : "",
              backdrop: m.backdrop_path
                ? "https://image.tmdb.org/t/p/w780" + m.backdrop_path
                : "",
              overview: m.overview || "",
              rating: m.vote_average || 0,
              genre: "",
              runtime: 0,
              trailerUrl: ""
            };
          });
        }
      }
    }catch(e){ /* fall through to iTunes */ }
  }

  // 2. iTunes Search API -- always works without key
  try{
    var url = "https://itunes.apple.com/search?term=" +
      encodeURIComponent(q) +
      "&media=movie&entity=movie&limit=15";
    var res = await fetch(url);
    if(!res.ok) throw new Error("iTunes search failed");
    var data = await res.json();

    return (data.results || []).map(function(m){
      var poster = m.artworkUrl100
        ? m.artworkUrl100.replace("100x100bb", "600x900bb")
        : "";
      var releaseDate = m.releaseDate ? m.releaseDate.slice(0,10) : "";
      var year = releaseDate ? releaseDate.slice(0,4) : "--";

      return {
        source: "itunes",
        sourceId: "itunes-" + m.trackId,
        title: m.trackName || "Untitled",
        year: year,
        releaseDate: releaseDate,
        poster: poster,
        backdrop: "",
        overview: m.longDescription || m.shortDescription || "",
        rating: 0,
        genre: m.primaryGenreName || "",
        runtime: m.trackTimeMillis ? Math.round(m.trackTimeMillis / 60000) : 0,
        trailerUrl: m.previewUrl || ""
      };
    });
  }catch(e){
    console.error("Search error:", e);
    return [];
  }
}

/* =========================================================
   SEARCH DROPDOWN
========================================================= */
function renderSearchDropdown(query){
  if(!searchDropdown) return;

  if(!query || query.trim().length < 2){
    searchDropdown.classList.remove("open");
    searchDropdown.innerHTML = "";
    return;
  }

  searchDropdown.classList.add("open");
  searchDropdown.innerHTML =
    '<div class="search-loading">🔍 Searching "' + escapeHtml(query) + '"...</div>';

  searchMovies(query).then(function(results){
    searchResults = results;
    activeSearchIndex = -1;

    if(results.length === 0){
      searchDropdown.innerHTML =
        '<div class="search-empty">' +
          '<div style="font-size:32px;margin-bottom:10px;opacity:.5">🎬</div>' +
          '<div>No movies found for "<b>' + escapeHtml(query) + '</b>"</div>' +
          '<div style="margin-top:8px;font-size:.72rem">Try a different spelling.</div>' +
        '</div>';
      return;
    }

    var inVaultIds = {};
    vault.forEach(function(v){ inVaultIds[v.sourceId] = true; });

    var html = '<div class="search-section-title">Search Results (' + results.length + ')</div>';

    results.forEach(function(m, i){
      var already = inVaultIds[m.sourceId];
      html +=
        '<div class="search-result" data-result-index="' + i + '">' +
          '<img src="' + escapeAttr(m.poster || "") + '" alt="" ' +
               'onerror="this.src=\'https://placehold.co/60x90/1c1332/ffb800?text=?\'">' +
          '<div class="search-result-info">' +
            '<strong>' + escapeHtml(m.title) + '</strong>' +
            '<small>' + escapeHtml(m.year) +
              (m.genre ? ' • ' + escapeHtml(m.genre) : '') +
              (m.rating ? ' • ⭐ ' + Number(m.rating).toFixed(1) : '') +
            '</small>' +
          '</div>' +
          '<button class="search-result-add" data-add-index="' + i + '"' +
            (already ? ' disabled style="opacity:.5;cursor:not-allowed"' : '') +
          '>' + (already ? '✓ Added' : '+ Add') + '</button>' +
        '</div>';
    });

    searchDropdown.innerHTML = html;
  });
}

/* =========================================================
   ADD MOVIE
========================================================= */
function addMovieFromSearch(result, status){
  if(!result) return;
  status = status || "want";

  var exists = vault.find(function(v){
    return v.sourceId === result.sourceId ||
      (v.title.toLowerCase() === result.title.toLowerCase() && v.year === result.year);
  });

  if(exists){
    showToast("Already in your vault", "error");
    return;
  }

  var movie = {
    id: "cv-" + Date.now() + "-" + Math.random().toString(36).slice(2,7),
    sourceId: result.sourceId || "",
    title: result.title,
    year: result.year,
    releaseDate: result.releaseDate || "",
    poster: result.poster || "",
    backdrop: result.backdrop || "",
    overview: result.overview || "",
    tmdbRating: Number(result.rating) || 0,
    genre: result.genre || "",
    runtime: result.runtime || 0,
    trailerUrl: result.trailerUrl || "",
    watchUrl: "",
    downloadUrl: "",
    userRating: 0,
    notes: "",
    status: status,
    favorite: false,
    addedAt: Date.now(),
    watchedAt: null
  };

  vault.unshift(movie);
  saveVault();
  renderMovies();
  updateStats();
  showToast("✓ " + movie.title + " added to vault");

  if(typeof window.__cvCloudSave === "function"){
    window.__cvCloudSave();
  }
}

/* =========================================================
   FILTER + SORT
========================================================= */
function getFilteredMovies(){
  var list = vault.slice();

  if(currentFilter === "favorites"){
    list = list.filter(function(m){ return m.favorite; });
  }else if(currentFilter !== "all"){
    list = list.filter(function(m){ return m.status === currentFilter; });
  }

  if(currentSearch){
    var q = currentSearch.toLowerCase();
    list = list.filter(function(m){
      return (m.title || "").toLowerCase().indexOf(q) !== -1 ||
             (m.year || "").indexOf(q) !== -1 ||
             (m.genre || "").toLowerCase().indexOf(q) !== -1;
    });
  }

  if(currentSort === "added"){
    list.sort(function(a,b){ return (b.addedAt || 0) - (a.addedAt || 0); });
  }else if(currentSort === "title"){
    list.sort(function(a,b){ return a.title.localeCompare(b.title); });
  }else if(currentSort === "year"){
    list.sort(function(a,b){ return (parseInt(b.year)||0) - (parseInt(a.year)||0); });
  }else if(currentSort === "rating"){
    list.sort(function(a,b){ return (b.userRating||0) - (a.userRating||0); });
  }else if(currentSort === "tmdbRating"){
    list.sort(function(a,b){ return (b.tmdbRating||0) - (a.tmdbRating||0); });
  }

  return list;
}

/* =========================================================
   RENDER MOVIE GRID
========================================================= */
function renderMovies(){
  if(!movieList) return;

  var list = getFilteredMovies();

  if(list.length === 0){
    movieList.innerHTML =
      '<li class="empty-state">' +
        '<div class="empty-icon">🎬</div>' +
        '<h3>' + (vault.length === 0 ? "Your vault is empty" : "No matches found") + '</h3>' +
        '<p>' +
          (vault.length === 0
            ? "Use the Universal Search above to find any movie and add it to your personal collection."
            : "Try adjusting your filters or search term.") +
        '</p>' +
      '</li>';
    return;
  }

  movieList.innerHTML = "";

  list.forEach(function(m){
    var li = document.createElement("li");
    li.className = "movie-card";
    li.dataset.id = m.id;

    var statusMeta = {
      want:     { label: "🎯 Want" },
      watching: { label: "▶️ Watching" },
      watched:  { label: "✅ Watched" },
      dropped:  { label: "⏸️ Dropped" }
    }[m.status] || { label: "🎯 Want" };

    var html = '';
    html += '<div class="poster-container">';
    html +=   '<img class="poster" src="' + escapeAttr(m.poster || '') + '" ';
    html +=     'alt="' + escapeAttr(m.title) + '" ';
    html +=     'loading="lazy" data-title="' + escapeAttr(m.title) + '">';
    html +=   '<div class="poster-overlay"></div>';
    html +=   '<div class="status-badge">' + statusMeta.label + '</div>';
    html +=   '<button class="favorite-btn ' + (m.favorite ? 'active' : '') + '" ';
    html +=     'data-fav="' + m.id + '" title="Favorite">';
    html +=     (m.favorite ? '❤️' : '♡');
    html +=   '</button>';
    html += '</div>';

    html += '<div class="movie-info">';
    html +=   '<h3 class="movie-title">' + escapeHtml(m.title) + '</h3>';
    html +=   '<div class="movie-meta">';
    html +=     '<span class="meta-item">📅 ' + escapeHtml(m.year || "--") + '</span>';
    if(m.tmdbRating) html += '<span class="meta-item rating">⭐ ' + Number(m.tmdbRating).toFixed(1) + '</span>';
    if(m.userRating) html += '<span class="meta-item rating">🌟 ' + m.userRating + '/10</span>';
    if(m.genre) html += '<span class="meta-item">' + escapeHtml(m.genre) + '</span>';
    html +=   '</div>';
    html += '</div>';

    li.innerHTML = html;

    var img = li.querySelector(".poster");
    if(img) posterFallback(img);

    li.addEventListener("click", function(e){
      if(e.target.closest("button")) return;
      openMovieModal(m.id);
    });

    var favBtn = li.querySelector("[data-fav]");
    if(favBtn){
      favBtn.addEventListener("click", function(e){
        e.stopPropagation();
        toggleFavorite(m.id);
      });
    }

    movieList.appendChild(li);
  });
}

/* =========================================================
   STATS
========================================================= */
function updateStats(){
  var total    = vault.length;
  var want     = vault.filter(function(m){ return m.status === "want"; }).length;
  var watching = vault.filter(function(m){ return m.status === "watching"; }).length;
  var watched  = vault.filter(function(m){ return m.status === "watched"; }).length;
  var favs     = vault.filter(function(m){ return m.favorite; }).length;

  if(statTotal)    statTotal.textContent = total;
  if(statWant)     statWant.textContent = want;
  if(statWatching) statWatching.textContent = watching;
  if(statWatched)  statWatched.textContent = watched;
  if(statFav)      statFav.textContent = favs;

  var percent = total > 0 ? Math.round((watched / total) * 100) : 0;
  if(progressBar)  progressBar.style.width = percent + "%";
  if(progressText) progressText.textContent = watched + "/" + total + " (" + percent + "%)";
}

/* =========================================================
   FAVORITE TOGGLE
========================================================= */
function toggleFavorite(id){
  var m = vault.find(function(v){ return v.id === id; });
  if(!m) return;
  m.favorite = !m.favorite;
  saveVault();
  renderMovies();
  updateStats();
  showToast(m.favorite ? "❤️ Added to favorites" : "Removed from favorites");
  if(typeof window.__cvCloudSave === "function") window.__cvCloudSave();
}

/* =========================================================
   STATUS UPDATE
========================================================= */
function setStatus(id, status){
  var m = vault.find(function(v){ return v.id === id; });
  if(!m) return;
  m.status = status;
  if(status === "watched" && !m.watchedAt) m.watchedAt = Date.now();
  saveVault();
  renderMovies();
  updateStats();
  if(modalMovieId === id) refreshModalStatus();
  if(typeof window.__cvCloudSave === "function") window.__cvCloudSave();
}

/* =========================================================
   MODAL
========================================================= */
function openMovieModal(id){
  var m = vault.find(function(v){ return v.id === id; });
  if(!m) return;

  modalMovieId = id;

  modalPoster.src = m.poster || "";
  modalPoster.dataset.title = m.title;
  posterFallback(modalPoster);
  modalTitle.textContent = m.title;
  modalDesc.textContent = m.overview || "No description available.";
  userNote.value = m.notes || "";

  var metaHtml = '';
  metaHtml += '<span>📅 ' + escapeHtml(m.year || "--") + '</span>';
  if(m.tmdbRating) metaHtml += '<span>⭐ TMDB ' + Number(m.tmdbRating).toFixed(1) + '</span>';
  if(m.genre) metaHtml += '<span>🎭 ' + escapeHtml(m.genre) + '</span>';
  if(m.runtime) metaHtml += '<span>⏱️ ' + m.runtime + ' min</span>';
  modalMeta.innerHTML = metaHtml;

  statusBtns.forEach(function(btn){
    btn.classList.toggle("active", btn.dataset.status === m.status);
  });

  modalFavBtn.textContent = m.favorite ? "❤️ Favorited" : "♡ Favorite";
  modalFavBtn.style.color = m.favorite ? "var(--primary)" : "#fff";

  modalTrailer.style.display  = m.trailerUrl  ? "inline-block" : "none";
  modalWatch.style.display    = m.watchUrl    ? "inline-block" : "none";
  modalDownload.style.display = m.downloadUrl ? "inline-block" : "none";

  movieModal.classList.add("active");
  document.body.style.overflow = "hidden";
}

function closeMovieModal(){
  movieModal.classList.remove("active");
  document.body.style.overflow = "";
  modalMovieId = null;
}

function refreshModalStatus(){
  var m = vault.find(function(v){ return v.id === modalMovieId; });
  if(!m) return;
  statusBtns.forEach(function(btn){
    btn.classList.toggle("active", btn.dataset.status === m.status);
  });
}

/* =========================================================
   SEARCH INPUT EVENTS
========================================================= */
if(universalSearch){
  universalSearch.addEventListener("input", function(e){
    var q = e.target.value;
    currentSearch = q;
    if(searchClear) searchClear.classList.toggle("visible", q.length > 0);

    clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(function(){
      renderSearchDropdown(q);
    }, 320);

    renderMovies();
  });

  universalSearch.addEventListener("keydown", function(e){
    var results = searchDropdown.querySelectorAll(".search-result");
    if(!results.length) return;

    if(e.key === "ArrowDown"){
      e.preventDefault();
      activeSearchIndex = Math.min(activeSearchIndex + 1, results.length - 1);
      updateActiveSearch();
    }else if(e.key === "ArrowUp"){
      e.preventDefault();
      activeSearchIndex = Math.max(activeSearchIndex - 1, 0);
      updateActiveSearch();
    }else if(e.key === "Enter"){
      e.preventDefault();
      if(activeSearchIndex >= 0 && searchResults[activeSearchIndex]){
        addMovieFromSearch(searchResults[activeSearchIndex]);
        clearSearch();
      }
    }else if(e.key === "Escape"){
      clearSearch();
    }
  });
}

function updateActiveSearch(){
  var results = searchDropdown.querySelectorAll(".search-result");
  results.forEach(function(el, i){
    el.classList.toggle("active", i === activeSearchIndex);
  });
  if(activeSearchIndex >= 0 && results[activeSearchIndex]){
    results[activeSearchIndex].scrollIntoView({block:"nearest"});
  }
}

function clearSearch(){
  if(universalSearch) universalSearch.value = "";
  currentSearch = "";
  if(searchClear) searchClear.classList.remove("visible");
  if(searchDropdown){
    searchDropdown.classList.remove("open");
    searchDropdown.innerHTML = "";
  }
  searchResults = [];
  activeSearchIndex = -1;
  renderMovies();
}

if(searchClear){
  searchClear.addEventListener("click", clearSearch);
}

/* =========================================================
   DROPDOWN CLICK
========================================================= */
if(searchDropdown){
  searchDropdown.addEventListener("click", function(e){
    var addBtn = e.target.closest("[data-add-index]");
    if(addBtn){
      e.stopPropagation();
      var idx = parseInt(addBtn.dataset.addIndex, 10);
      addMovieFromSearch(searchResults[idx]);
      addBtn.textContent = "✓ Added";
      addBtn.disabled = true;
      addBtn.style.opacity = ".5";
      addBtn.style.cursor = "not-allowed";
      return;
    }
    var resultEl = e.target.closest("[data-result-index]");
    if(resultEl){
      var i = parseInt(resultEl.dataset.resultIndex, 10);
      var r = searchResults[i];
      if(r) addMovieFromSearch(r);
    }
  });
}

/* Close dropdown on outside click */
document.addEventListener("click", function(e){
  if(!e.target.closest("#searchSection") && searchDropdown){
    searchDropdown.classList.remove("open");
  }
});

/* =========================================================
   FILTERS
========================================================= */
filterBtns.forEach(function(btn){
  btn.addEventListener("click", function(){
    filterBtns.forEach(function(b){ b.classList.remove("active"); });
    btn.classList.add("active");
    currentFilter = btn.dataset.filter;
    renderMovies();
  });
});

statCards.forEach(function(card){
  card.addEventListener("click", function(){
    var f = card.dataset.statusFilter;
    if(!f) return;
    statCards.forEach(function(c){ c.classList.remove("active"); });
    card.classList.add("active");

    filterBtns.forEach(function(b){
      b.classList.toggle("active", b.dataset.filter === f);
    });
    currentFilter = f;
    renderMovies();
  });
});

/* =========================================================
   SORT
========================================================= */
if(sortSelect){
  sortSelect.addEventListener("change", function(e){
    currentSort = e.target.value;
    renderMovies();
  });
}

/* =========================================================
   ACCENT THEME
========================================================= */
themeChoices.forEach(function(btn){
  btn.addEventListener("click", function(){
    var theme = btn.dataset.theme;
    document.body.classList.remove("theme-gold","theme-blue","theme-purple","theme-green","theme-red");
    document.body.classList.add("theme-" + theme);
    themeChoices.forEach(function(b){ b.classList.toggle("active", b === btn); });
    try{ localStorage.setItem(CONFIG.STORAGE.ACCENT, theme); }catch(e){}
  });
});

/* =========================================================
   LIGHT / DARK
========================================================= */
if(themeBtn){
  themeBtn.addEventListener("click", function(){
    document.body.classList.toggle("light-mode");
    var isLight = document.body.classList.contains("light-mode");
    themeBtn.textContent = isLight ? "☀️ Light" : "🌙 Dark";
    try{ localStorage.setItem(CONFIG.STORAGE.LIGHT, isLight ? "1" : "0"); }catch(e){}
  });
}

/* =========================================================
   MODAL EVENTS
========================================================= */
if(modalClose) modalClose.addEventListener("click", closeMovieModal);
if(movieModal){
  movieModal.addEventListener("click", function(e){
    if(e.target === movieModal) closeMovieModal();
  });
}
document.addEventListener("keydown", function(e){
  if(e.key === "Escape" && movieModal.classList.contains("active")){
    closeMovieModal();
  }
});

if(modalTrailer){
  modalTrailer.addEventListener("click", function(){
    var m = vault.find(function(v){ return v.id === modalMovieId; });
    if(m && m.trailerUrl) window.open(m.trailerUrl, "_blank", "noopener");
  });
}
if(modalWatch){
  modalWatch.addEventListener("click", function(){
    var m = vault.find(function(v){ return v.id === modalMovieId; });
    if(m && m.watchUrl) window.open(m.watchUrl, "_blank", "noopener");
  });
}
if(modalDownload){
  modalDownload.addEventListener("click", function(){
    var m = vault.find(function(v){ return v.id === modalMovieId; });
    if(m && m.downloadUrl) window.open(m.downloadUrl, "_blank", "noopener");
  });
}
if(modalFavBtn){
  modalFavBtn.addEventListener("click", function(){
    if(modalMovieId) toggleFavorite(modalMovieId);
    var m = vault.find(function(v){ return v.id === modalMovieId; });
    if(m){
      modalFavBtn.textContent = m.favorite ? "❤️ Favorited" : "♡ Favorite";
      modalFavBtn.style.color = m.favorite ? "var(--primary)" : "#fff";
    }
  });
}

statusBtns.forEach(function(btn){
  btn.addEventListener("click", function(){
    if(!modalMovieId) return;
    setStatus(modalMovieId, btn.dataset.status);
  });
});

/* Notes auto-save */
if(userNote){
  var saveNote = function(){
    var m = vault.find(function(v){ return v.id === modalMovieId; });
    if(!m) return;
    m.notes = userNote.value;
    saveVault();
    if(typeof window.__cvCloudSave === "function") window.__cvCloudSave();
  };
  userNote.addEventListener("blur", saveNote);
  var noteTimer;
  userNote.addEventListener("input", function(){
    clearTimeout(noteTimer);
    noteTimer = setTimeout(saveNote, 600);
  });
}

/* =========================================================
   HERO BUTTONS
========================================================= */
var heroExplore = $("heroExploreBtn");
var heroWatchlist = $("heroWatchlistBtn");

if(heroExplore){
  heroExplore.addEventListener("click", function(){
    if(universalSearch){
      universalSearch.scrollIntoView({behavior:"smooth", block:"center"});
      setTimeout(function(){ universalSearch.focus(); }, 500);
    }
  });
}
if(heroWatchlist){
  heroWatchlist.addEventListener("click", function(){
    if(movieList) movieList.scrollIntoView({behavior:"smooth", block:"start"});
  });
}

/* =========================================================
   INIT
========================================================= */
function init(){
  loadVault();

  try{
    var accent = localStorage.getItem(CONFIG.STORAGE.ACCENT) || "gold";
    document.body.classList.add("theme-" + accent);
    themeChoices.forEach(function(b){
      b.classList.toggle("active", b.dataset.theme === accent);
    });
  }catch(e){}

  try{
    if(localStorage.getItem(CONFIG.STORAGE.LIGHT) === "1"){
      document.body.classList.add("light-mode");
      if(themeBtn) themeBtn.textContent = "☀️ Light";
    }
  }catch(e){}

  renderMovies();
  updateStats();

  console.log("🎬 CineVault ready -- " + vault.length + " movie(s) in vault.");
}

init();

/* =========================================================
   CLOUD BRIDGE -- used by Part 3 (Firebase)
========================================================= */
window.__cvBridge = {
  getState: function(){
    return {
      movies: JSON.parse(JSON.stringify(vault))
    };
  },
  applyState: function(state){
    if(!state) return;
    vault = Array.isArray(state.movies) ? state.movies : [];
    saveVault();
    renderMovies();
    updateStats();
  },
  addMovie: addMovieFromSearch,
  showToast: showToast
};

})();
</script>
