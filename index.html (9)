<!-- CLOUD STATUS PILL -->
<div id="cvCloudStatus" style="
  position:fixed;bottom:12px;right:12px;z-index:10000;
  padding:7px 12px;border-radius:999px;
  background:rgba(10,7,16,.9);border:1px solid rgba(255,184,0,.3);
