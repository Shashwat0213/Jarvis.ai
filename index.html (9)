/* =========================================================
   MODAL -- MOVIE DETAILS
========================================================= */
.modal{
  position:fixed;
  inset:0;
  z-index:9998;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:rgba(3,2,8,.85);
  backdrop-filter:blur(14px);
  opacity:0;
  visibility:hidden;
  transition:opacity .35s ease, visibility .35s ease;
}

.modal.active{opacity:1;visibility:visible;}

.modal-content{
  width:min(920px,96vw);
  max-height:90vh;
  display:grid;
  grid-template-columns:280px 1fr;
  gap:24px;
  padding:24px;
  overflow:auto;
  background:linear-gradient(145deg,#1c1332,#0d0819);
  border:1px solid var(--border);
  border-radius:22px;
  box-shadow:0 0 40px rgba(255,184,0,.18), 0 0 100px rgba(168,85,247,.15);
  transform:translateY(40px) scale(.92);
  transition:transform .45s cubic-bezier(.16,1,.3,1);
  position:relative;
}

.modal.active .modal-content{transform:translateY(0) scale(1);}

.modal-poster{
  width:100%;
  height:420px;
  object-fit:cover;
  border-radius:14px;
  border:1px solid var(--border);
