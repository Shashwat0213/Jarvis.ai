/* =========================================================
   SAVE / LOAD
========================================================= */
function saveData(){
    localStorage.setItem("mcuWatched",   JSON.stringify(watched));
    localStorage.setItem("mcuFavorites", JSON.stringify(favorites));
    localStorage.setItem("mcuSound",     soundEnabled);

    /* Firebase sync (agar signed in hai) */
    if(typeof window.syncToFirebase === "function"){
        window.syncToFirebase();
    }
}

/* Purane numeric keys ko naye id-based keys mein convert karo */
(function migrateLegacyKeys(){
    const hasNumeric =
        Object.keys(watched).some(k => /^\d+$/.test(k)) ||
        Object.keys(favorites).some(k => /^\d+$/.test(k));

    if(!hasNumeric) return;

    const newWatched = {};
    const newFavs    = {};
    movies.forEach((movie, i) => {
        if(watched[i])   newWatched[movie.id] = true;
        if(favorites[i]) newFavs[movie.id]    = true;
    });

    watched   = { ...newWatched };
    favorites = { ...newFavs };
    saveData();
})();

/* =========================================================
   SOUND EFFECTS
========================================================= */
function playSound(url, volume = 0.35){
    if(!soundEnabled) return;
    try {
        const audio = new Audio(url);
        audio.volume = volume;
        audio.play().catch(() => {});
    } catch(e) { /* ignore */ }
}
const playButtonSound = () => playSound("https://actions.google.com/sounds/v1/cartoon/pop.ogg", 0.35);
