/* =========================================================
   POSTER FALLBACK
========================================================= */
function attachPosterFallback(img, title){
    img.onerror = function(){
        this.onerror = null;
        const label = encodeURIComponent(title || "MARVEL");
        this.src = "https://placehold.co/500x750/0d1422/00e5ff?text=" + label;
    };
}

/* =========================================================
   ESCAPE HELPERS
========================================================= */
function escapeHTML(str){
    return String(str ?? "").replace(/[&<>"']/g, c => ({
        "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;"
    }[c]));
}
function escapeAttr(str){
    return escapeHTML(str);
}

/* =========================================================
   FILTER / SORT
========================================================= */
function getFilteredMovies(){
    let result = movies.map((m, i) => ({ ...m, originalIndex: i }));

    if(currentSearch){
        const q = currentSearch.toLowerCase().trim();
        result = result.filter(m => m.title.toLowerCase().includes(q));
    }

    if(currentFilter === "movie")          result = result.filter(m => m.type === "movie");
    else if(currentFilter === "series")    result = result.filter(m => m.type === "series");
    else if(currentFilter === "watched")   result = result.filter(m => watched[m.id]);
    else if(currentFilter === "unwatched") result = result.filter(m => !watched[m.id]);
    else if(currentFilter === "favorites") result = result.filter(m => favorites[m.id]);

    if(currentSort === "default" || currentSort === "timeline"){
        result.sort((a, b) => (a.timelineSlot || 9999) - (b.timelineSlot || 9999));
    } else if(currentSort === "title"){
        result.sort((a, b) => a.title.localeCompare(b.title));
    } else if(currentSort === "year"){
        result.sort((a, b) => a.year - b.year);
    } else if(currentSort === "rating"){
        result.sort((a, b) => (b.rating || 0) - (a.rating || 0));
    } else if(currentSort === "phase"){
        result.sort((a, b) => a.phase.localeCompare(b.phase));
    }

    return result;
}

/* =========================================================
   RENDER MOVIES
========================================================= */
function renderMovies(){
    movieList.innerHTML = "";
    const filtered = getFilteredMovies();

    if(filtered.length === 0){
        movieList.innerHTML = `
            <li class="empty-state">
                <div class="empty-icon">🔍</div>
                <p>No movies found.</p>
            </li>`;
        updateStats();
        renderV3();
        return;
    }

    filtered.forEach(movie => {
        const li = document.createElement("li");
        li.className = "movie-card";
        li.dataset.id = movie.id;

        const isWatched  = !!watched[movie.id];
        const isFavorite = !!favorites[movie.id];

        /* --- Poster --- */
        const posterContainer = document.createElement("div");
        posterContainer.className = "poster-container";

        const poster = document.createElement("img");
        poster.className = "poster";
        poster.loading = "lazy";
        poster.src = movie.poster;
        poster.alt = movie.title + " poster";
        attachPosterFallback(poster, movie.title);

        const overlay = document.createElement("div");
        overlay.className = "poster-overlay";

        const phaseBadge = document.createElement("div");
        phaseBadge.className = "phase-badge";
        phaseBadge.textContent = movie.phase;

        const favBtn = document.createElement("button");
        favBtn.className = "favorite-btn" + (isFavorite ? " active" : "");
        favBtn.innerHTML = isFavorite ? "❤️" : "♡";
        favBtn.title = "Toggle favorite";
        favBtn.addEventListener("click", e => {
            e.stopPropagation();
            favorites[movie.id] = !favorites[movie.id];
            playButtonSound();
            saveData();
            renderMovies();
        });

        posterContainer.appendChild(poster);
        posterContainer.appendChild(overlay);
        posterContainer.appendChild(phaseBadge);

        /* Coming Soon badge */
        if(movie.upcoming){
            const csBadge = document.createElement("div");
            csBadge.className = "coming-soon-badge";
            csBadge.textContent = "Coming Soon";
            posterContainer.appendChild(csBadge);
        }

        posterContainer.appendChild(favBtn);

        /* --- Info --- */
        const info = document.createElement("div");
        info.className = "movie-info";

        const title = document.createElement("h2");
        title.className = "movie-title";
        title.textContent = movie.title;
        if(isWatched){
            title.style.textDecoration = "line-through";
            title.style.opacity = "0.6";
        }

        /* Type badge */
        const typeBadge = document.createElement("span");
        typeBadge.className = "movie-type-badge";
        const typeLabel = movie.type === "series" ? "📺 WEB SERIES"
                        : movie.type === "special" ? "🎬 SPECIAL"
                        : "🎬 MOVIE";
        typeBadge.textContent = typeLabel + " • " + movie.importance.toUpperCase();
        typeBadge.style.cssText = "display:inline-block;margin:3px 0 7px;padding:5px 8px;border:1px solid rgba(255,255,255,.14);border-radius:999px;font-size:.55rem;font-weight:800;letter-spacing:.04em;opacity:.9";

        /* Meta */
        const meta = document.createElement("div");
        meta.className = "movie-meta";

        const yearEl = document.createElement("span");
        yearEl.className = "meta-item";
        yearEl.textContent = "📅 " + movie.releaseDate;

        const ratingEl = document.createElement("span");
        ratingEl.className = "meta-item rating";
        ratingEl.textContent = movie.rating ? "⭐ " + Number(movie.rating).toFixed(1) : "⭐ TBA";

        const phaseEl = document.createElement("span");
        phaseEl.className = "meta-item";
        phaseEl.textContent = "⚡ " + movie.phase;

        meta.appendChild(yearEl);
        meta.appendChild(ratingEl);
        meta.appendChild(phaseEl);

        /* Watch row */
        const watchRow = document.createElement("div");
        watchRow.className = "watch-row";

        const watchLabel = document.createElement("label");
        watchLabel.className = "watch-label";

        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.className = "watch-checkbox";
        checkbox.checked = isWatched;

        const watchText = document.createElement("span");
        watchText.textContent = isWatched ? "Watched" : "Mark as watched";
        if(isWatched) watchText.classList.add("watched-text");

        checkbox.addEventListener("change", () => {
            watched[movie.id] = checkbox.checked;
            playTickSound();
            saveData();
            renderMovies();
        });

        watchLabel.appendChild(checkbox);
        watchLabel.appendChild(watchText);

        const favStatus = document.createElement("span");
        favStatus.className = "watch-label";
        favStatus.textContent = isFavorite ? "❤️ Favorite" : "♡";

        watchRow.appendChild(watchLabel);
        watchRow.appendChild(favStatus);

        /* --- Media actions (Trailer + Download) --- */
        const mediaActions = document.createElement("div");
        mediaActions.className = "media-actions";

        /* Trailer */
        if(movie.trailerUrl){
            const trailerLink = document.createElement("a");
            trailerLink.className = "btn trailer-btn";
            trailerLink.href = movie.trailerUrl;
            trailerLink.target = "_blank";
            trailerLink.rel = "noopener noreferrer";
            trailerLink.textContent = "▶ Trailer";
            mediaActions.appendChild(trailerLink);
        } else {
            const trailerDisabled = document.createElement("button");
            trailerDisabled.className = "btn trailer-btn";
            trailerDisabled.type = "button";
            trailerDisabled.disabled = true;
            trailerDisabled.textContent = "▶ Trailer — N/A";
            mediaActions.appendChild(trailerDisabled);
        }

        /* Download */
        if(movie.downloadUrl && movie.downloadUrl.trim() !== ""){
            const dlLink = document.createElement("a");
            dlLink.className = "btn download-btn";
            dlLink.href = movie.downloadUrl;
            dlLink.target = "_blank";
            dlLink.rel = "noopener noreferrer";
            dlLink.textContent = "⬇ Download";
            mediaActions.appendChild(dlLink);
        } else {
            const dlDisabled = document.createElement("button");
            dlDisabled.className = "btn download-btn";
            dlDisabled.type = "button";
            dlDisabled.disabled = true;
            dlDisabled.textContent = "⬇ Coming Soon";
            mediaActions.appendChild(dlDisabled);
        }

        /* --- Coming Soon timer (sirf upcoming ke liye) --- */
        let comingTimerEl = null;
        if(movie.upcoming && movie.releaseDate){
            comingTimerEl = document.createElement("div");
            comingTimerEl.className = "coming-timer";
            comingTimerEl.dataset.release = movie.releaseDate + "T00:00:00+05:30";
            comingTimerEl.innerHTML = `
                <div class="coming-timer__label">⏱ Releases In</div>
                <div class="coming-timer__digits">
                    <div class="coming-timer__unit"><b data-unit="d">000</b><span>Days</span></div>
                    <div class="coming-timer__unit"><b data-unit="h">00</b><span>Hrs</span></div>
                    <div class="coming-timer__unit"><b data-unit="m">00</b><span>Min</span></div>
                    <div class="coming-timer__unit"><b data-unit="s">00</b><span>Sec</span></div>
                </div>
            `;
        }

        /* --- Build card --- */
        info.appendChild(title);
        info.appendChild(typeBadge);
        info.appendChild(meta);
        info.appendChild(watchRow);
        info.appendChild(mediaActions);
        if(comingTimerEl) info.appendChild(comingTimerEl);

        li.appendChild(posterContainer);
        li.appendChild(info);

        /* Click → modal (buttons/checkbox ignore) */
        li.addEventListener("click", e => {
            if(e.target.closest("button") ||
               e.target.closest("input") ||
               e.target.closest("label") ||
               e.target.closest("a")) return;
            openMovieModal(movie);
        });

        movieList.appendChild(li);
    });

    updateStats();
    renderV3();
    startAllComingTimers();
}

/* =========================================================
   STATS
========================================================= */
function updateStats(){
    const total     = movies.length;
    const done      = movies.filter(m => watched[m.id]).length;
    const favs      = movies.filter(m => favorites[m.id]).length;
    const remaining = total - done;
    const percent   = total > 0 ? Math.round((done / total) * 100) : 0;

    if(totalMoviesEl)   totalMoviesEl.textContent = total;
    if(watchedMoviesEl) watchedMoviesEl.textContent = done;
    if(remainingEl)     remainingEl.textContent = remaining;
    if(favoriteEl)      favoriteEl.textContent = favs;
    if(progressBar)     progressBar.style.width = percent + "%";
    if(progressText)    progressText.textContent = `${done}/${total} (${percent}%)`;
}

/* =========================================================
   V3 DASHBOARD
========================================================= */
function renderV3(){
    const name = localStorage.getItem("mcuV3Name") || "Shashwat";
    if(v3Greeting) v3Greeting.textContent = `Welcome back, ${name} ⚡`;
    if(v3Avatar)   v3Avatar.textContent = name.trim().charAt(0).toUpperCase() || "S";
    if(v3NameInput) v3NameInput.value = name;

    const done      = movies.filter(m => watched[m.id]).length;
    const favs      = movies.filter(m => favorites[m.id]).length;
    const remaining = movies.length - done;
    const percent   = movies.length ? Math.round((done / movies.length) * 100) : 0;

    if(v3WatchedEl)    v3WatchedEl.textContent = done;
    if(v3FavsEl)       v3FavsEl.textContent = favs;
    if(v3RemainingEl)  v3RemainingEl.textContent = remaining;
    if(v3ProgressText) v3ProgressText.textContent = percent + "%";
    if(v3ProgressFill) v3ProgressFill.style.width = percent + "%";

    /* Recommended Next — pehli unwatched released movie */
    const next = movies.find(m => !watched[m.id] && !m.upcoming) || movies.find(m => !watched[m.id]);
    if(next && v3NextTitle){
        v3NextTitle.textContent = next.title;
        v3NextMeta.textContent = `${next.phase} • ${next.year} • ${next.rating ? "⭐ " + next.rating : "TBA"}`;
        v3NextPoster.src = next.poster;
        attachPosterFallback(v3NextPoster, next.title);
        v3NextMovie.onclick = () => openMovieModal(next);
    } else if(v3NextTitle){
        v3NextTitle.textContent = "MCU Complete 🎉";
        v3NextMeta.textContent = "You have completed every item in this tracker.";
    }
}

if(v3SaveName){
    v3SaveName.addEventListener("click", () => {
        const val = (v3NameInput.value || "").trim() || "Shashwat";
        localStorage.setItem("mcuV3Name", val);
        renderV3();
        playButtonSound();
    });
}
