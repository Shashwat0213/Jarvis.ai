/* =========================================================
   MOVIE MODAL
========================================================= */
function openMovieModal(movie){
    currentModalMovie = movie;

    modalPoster.src = movie.poster;
    modalPoster.alt = movie.title + " poster";
    attachPosterFallback(modalPoster, movie.title);

    modalTitle.textContent = movie.title;

    /* Meta */
    modalMeta.innerHTML = "";
    const metaItems = [
        "📅 " + movie.releaseDate,
        movie.rating ? "⭐ " + Number(movie.rating).toFixed(1) : "⭐ TBA",
        "⚡ " + movie.phase,
        "🎬 " + movie.importance
    ];
    metaItems.forEach(text => {
        const span = document.createElement("span");
        span.textContent = text;
        modalMeta.appendChild(span);
    });

    /* Description */
    modalDescription.textContent = movie.description ||
        "Movie details are not available yet.";

    /* Trailer */
    if(movie.trailerUrl){
        modalTrailerBtn.style.display = "inline-flex";
        modalTrailerBtn.disabled = false;
        modalTrailerBtn.textContent = "▶ Trailer";
        modalTrailerBtn.onclick = () => window.open(movie.trailerUrl, "_blank", "noopener");
    } else {
        modalTrailerBtn.style.display = "none";
    }

    /* Watched */
    modalWatchBtn.textContent = watched[movie.id] ? "✓ Watched" : "✓ Mark Watched";
    modalWatchBtn.onclick = () => {
        watched[movie.id] = !watched[movie.id];
        modalWatchBtn.textContent = watched[movie.id] ? "✓ Watched" : "✓ Mark Watched";
        playButtonSound();
        saveData();
        renderMovies();
    };

    /* Favorite */
    modalFavoriteBtn.textContent = favorites[movie.id] ? "❤️ Favorited" : "♡ Favorite";
    modalFavoriteBtn.onclick = () => {
        favorites[movie.id] = !favorites[movie.id];
        modalFavoriteBtn.textContent = favorites[movie.id] ? "❤️ Favorited" : "♡ Favorite";
        playButtonSound();
        saveData();
        renderMovies();
    };

    /* Download */
    if(movie.downloadUrl && movie.downloadUrl.trim() !== ""){
        modalDownloadBtn.style.display = "inline-flex";
        modalDownloadBtn.disabled = false;
        modalDownloadBtn.textContent = "⬇ Download";
        modalDownloadBtn.onclick = () => window.open(movie.downloadUrl, "_blank", "noopener");
    } else {
        modalDownloadBtn.style.display = "inline-flex";
        modalDownloadBtn.disabled = true;
        modalDownloadBtn.textContent = "⬇ Download — Coming Soon";
        modalDownloadBtn.onclick = null;
    }

    /* Coming Soon timer */
    if(movie.upcoming && movie.releaseDate){
        modalComingSoon.style.display = "block";
        startModalTimer(movie.releaseDate);
    } else {
        modalComingSoon.style.display = "none";
        stopModalTimer();
    }

    /* Show */
    movieModal.classList.add("active");
    movieModal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
}

function closeMovieModal(){
    movieModal.classList.remove("active");
    movieModal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    stopModalTimer();
}

movieModalClose.addEventListener("click", closeMovieModal);
movieModal.addEventListener("click", e => {
    if(e.target === movieModal) closeMovieModal();
});
document.addEventListener("keydown", e => {
    if(e.key === "Escape" && movieModal.classList.contains("active")) closeMovieModal();
});

