    red:      { title: "Avengers: Endgame",       subtitle: "Marvel Red • Phase 3",     poster: "https://image.tmdb.org/t/p/w500/or06FN3Dka5tukK1e9sl16pB3iy.jpg" },
    blue:     { title: "Spider-Man: No Way Home", subtitle: "Multiverse Blue • Phase 4", poster: "https://image.tmdb.org/t/p/w500/1g0dhYtq4irTY1GPXvft6k4YLjm.jpg" },
    gold:     { title: "Avengers: Infinity War",  subtitle: "Infinity Gold • Phase 3",   poster: "https://image.tmdb.org/t/p/w500/7WsyChQLEftFiDOVTGkv3hFpyyt.jpg" },
    cosmic:   { title: "Guardians of the Galaxy", subtitle: "Cosmic • Phase 2",          poster: "https://image.tmdb.org/t/p/w500/r7vmZjiyZw9rpJMQJdXpjgiCOk9.jpg" },
    ironman:  { title: "Iron Man",                subtitle: "Iron Man • Phase 1",        poster: "https://image.tmdb.org/t/p/w500/78lPtwv72eTNqFW9COBYI0dWDJa.jpg" },
    gamma:    { title: "Hulk",                    subtitle: "Gamma Green • Phase 3",     poster: "https://image.tmdb.org/t/p/w500/uxzzxijgPIY7slzFvMotPv8wjKA.jpg" },
    doomsday: { title: "Avengers: Doomsday",      subtitle: "Doomsday • Phase 6",        poster: "https://image.tmdb.org/t/p/w500/8cdWjvZQUExUUTzyp4t6EDMubfO.jpg" }
};

function applyHeroTheme(theme){
    if(!heroThemeData[theme]) theme = "blue";
    document.body.classList.remove("theme-blue", "theme-gold", "theme-cosmic", "theme-ironman", "theme-gamma", "theme-doomsday");
    if(theme !== "red") document.body.classList.add("theme-" + theme);
    localStorage.setItem("mcuHeroTheme", theme);
    document.querySelectorAll("[data-hero-theme]").forEach(b => {
        b.classList.toggle("active", b.dataset.heroTheme === theme);
    });
}
document.querySelectorAll("[data-hero-theme]").forEach(btn => {
    btn.addEventListener("click", () => applyHeroTheme(btn.dataset.heroTheme));
});

document.getElementById("heroExploreBtn")?.addEventListener("click", () => {
    movieList.scrollIntoView({ behavior: "smooth", block: "start" });
});

/* Keyboard */
document.addEventListener("keydown", e => {
    if(e.key === "/" && document.activeElement !== searchInput && !movieModal.classList.contains("active")){
        e.preventDefault(); searchInput.focus();
    }
});

/* INIT */
loadTheme();
updateSoundBtn();
renderMovies();
applyHeroTheme(localStorage.getItem("mcuHeroTheme") || "blue");
tickDoomsday();

console.log("⚡ MCU Tracker loaded successfully!");
