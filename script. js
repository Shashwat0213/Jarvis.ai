function saveData(){
    localStorage.setItem("mcuWatched",   JSON.stringify(watched));
    localStorage.setItem("mcuFavorites", JSON.stringify(favorites));
    localStorage.setItem("mcuSound",     soundEnabled);
    if(typeof window.syncToFirebase === "function") window.syncToFirebase();
}

/* Numeric → id migration */
(function(){
    const hasNumeric = Object.keys(watched).some(k => /^\d+$/.test(k)) ||
                       Object.keys(favorites).some(k => /^\d+$/.test(k));
    if(!hasNumeric) return;
    const nw = {}, nf = {};
    movies.forEach((m, i) => {
        if(watched[i])   nw[m.id] = true;
        if(favorites[i]) nf[m.id] = true;
    });
    watched = nw; favorites = nf;
    saveData();
})();

function playSound(url, vol = 0.35){
    if(!soundEnabled) return;
    try { const a = new Audio(url); a.volume = vol; a.play().catch(()=>{}); } catch(e){}
}
const playButtonSound = () => playSound("https://actions.google.com/sounds/v1/cartoon/pop.ogg");
