function posterFallback(img, title){
    img.onerror = function(){
        this.onerror = null;
        this.src = "https://placehold.co/500x750/0d1422/00e5ff?text=" + encodeURIComponent(title || "MCU");
    };
}

function getFilteredMovies(){
    let result = movies.map((m, i) => ({ ...m, originalIndex: i }));
    if(currentSearch){
        const q = currentSearch.toLowerCase().trim();
        result = result.filter(m => m.title.toLowerCase().includes(q));
    }
    if(currentFilter === "movie")          result = result.filter(m => m.type === "movie");
    else if(currentFilter === "series")    result = result.filter(m => m.type === "series");
    else if(currentFilter === "watched")   result = result.filter(m => watched[m.id]);
    else if(currentFilter === "unwatched") result = result.filter(m => !watched[m.id]);
    else if(currentFilter === "favorites") result = result.filter(m => favorites[m.id]);

    if(currentSort === "default" || currentSort === "timeline"){
        result.sort((a,b) => (a.timelineSlot || 9999) - (b.timelineSlot || 9999));
    } else if(currentSort === "title"){
        result.sort((a,b) => a.title.localeCompare(b.title));
    } else if(currentSort === "year"){
        result.sort((a,b) => a.year - b.year);
    } else if(currentSort === "rating"){
        result.sort((a,b) => (b.rating || 0) - (a.rating || 0));
    } else if(currentSort === "phase"){
        result.sort((a,b) => a.phase.localeCompare(b.phase));
    }
    return result;
}

