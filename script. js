/* --- Doomsday timer (18 Dec 2026, IST) --- */
const DOOMSDAY_TARGET = Date.parse("2026-12-18T00:00:00+05:30");

function updateDoomsdayTimer(){
    const diff = Math.max(0, DOOMSDAY_TARGET - Date.now());
    const total = Math.floor(diff / 1000);
    const days = Math.floor(total / 86400);
    const hours = Math.floor((total % 86400) / 3600);
    const mins = Math.floor((total % 3600) / 60);
    const secs = total % 60;
    const pad = n => String(n).padStart(2, "0");
    const dEl = document.getElementById("doomsdayDays");
    const hEl = document.getElementById("doomsdayHours");
    const mEl = document.getElementById("doomsdayMinutes");
    const sEl = document.getElementById("doomsdaySeconds");
    if(dEl) dEl.textContent = String(days).padStart(3, "0");
    if(hEl) hEl.textContent = pad(hours);
    if(mEl) mEl.textContent = pad(mins);
    if(sEl) sEl.textContent = pad(secs);
}
setInterval(updateDoomsdayTimer, 1000);
updateDoomsdayTimer();

/* --- Coming soon timers (movie cards) --- */
function startAllComingTimers(){
    document.querySelectorAll(".coming-timer").forEach(el => {
        const target = Date.parse(el.dataset.release);
        if(isNaN(target)) return;

        function tick(){
            const diff = Math.max(0, target - Date.now());
            const total = Math.floor(diff / 1000);
            const d = el.querySelector('[data-unit="d"]');
            const h = el.querySelector('[data-unit="h"]');
            const m = el.querySelector('[data-unit="m"]');
            const s = el.querySelector('[data-unit="s"]');
            if(d) d.textContent = String(Math.floor(total / 86400)).padStart(3, "0");
            if(h) h.textContent = String(Math.floor((total % 86400) / 3600)).padStart(2, "0");
            if(m) m.textContent = String(Math.floor((total % 3600) / 60)).padStart(2, "0");
            if(s) s.textContent = String(total % 60).padStart(2, "0");
        }
        tick();
        el._interval = setInterval(tick, 1000);
    });
}

/* --- Modal timer --- */
let modalTimerInterval = null;
function startModalTimer(releaseDate){
    stopModalTimer();
    const target = Date.parse(releaseDate + "T00:00:00+05:30");
    if(isNaN(target)) return;

    function tick(){
        const diff = Math.max(0, target - Date.now());
        const total = Math.floor(diff / 1000);
        const pad = n => String(n).padStart(2, "0");
        const d = document.getElementById("modalTimerDays");
        const h = document.getElementById("modalTimerHours");
        const m = document.getElementById("modalTimerMinutes");
        const s = document.getElementById("modalTimerSeconds");
        if(d) d.textContent = String(Math.floor(total / 86400)).padStart(3, "0");
        if(h) h.textContent = pad(Math.floor((total % 86400) / 3600));
        if(m) m.textContent = pad(Math.floor((total % 3600) / 60));
        if(s) s.textContent = pad(total % 60);
    }
    tick();
    modalTimerInterval = setInterval(tick, 1000);
}
function stopModalTimer(){
    if(modalTimerInterval){
        clearInterval(modalTimerInterval);
        modalTimerInterval = null;
    }
}

