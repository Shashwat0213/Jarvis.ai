function updateStats(){
    const total     = movies.length;
    const done      = movies.filter(m => watched[m.id]).length;
    const favs      = movies.filter(m => favorites[m.id]).length;
    const remaining = total - done;
    const percent   = total > 0 ? Math.round((done / total) * 100) : 0;

    if(totalMoviesEl)   totalMoviesEl.textContent = total;
    if(watchedMoviesEl) watchedMoviesEl.textContent = done;
    if(remainingEl)     remainingEl.textContent = remaining;
    if(favoriteEl)      favoriteEl.textContent = favs;
    if(progressBar)     progressBar.style.width = percent + "%";
    if(progressText)    progressText.textContent = `${done}/${total} (${percent}%)`;
}

function renderV3(){
    const name = localStorage.getItem("mcuV3Name") || "Shashwat";
    if(v3Greeting) v3Greeting.textContent = `Welcome back, ${name} ⚡`;
    if(v3Avatar)   v3Avatar.textContent = name.trim().charAt(0).toUpperCase() || "S";
    if(v3NameInput) v3NameInput.value = name;

    const done      = movies.filter(m => watched[m.id]).length;
    const favs      = movies.filter(m => favorites[m.id]).length;
    const remaining = movies.length - done;
    const percent   = movies.length ? Math.round((done / movies.length) * 100) : 0;

    if(v3WatchedEl)    v3WatchedEl.textContent = done;
    if(v3FavsEl)       v3FavsEl.textContent = favs;
    if(v3RemainingEl)  v3RemainingEl.textContent = remaining;
    if(v3ProgressText) v3ProgressText.textContent = percent + "%";
    if(v3ProgressFill) v3ProgressFill.style.width = percent + "%";

    const next = movies.find(m => !watched[m.id] && !m.upcoming) || movies.find(m => !watched[m.id]);
    if(next && v3NextTitle){
        v3NextTitle.textContent = next.title;
        v3NextMeta.textContent = `${next.phase} • ${next.year} • ${next.rating ? "⭐ " + next.rating : "TBA"}`;
        v3NextPoster.src = next.poster;
        posterFallback(v3NextPoster, next.title);
        v3NextMovie.onclick = () => openMovieModal(next);
    }
}

