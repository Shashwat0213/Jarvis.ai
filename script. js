/* Modal */
function openMovieModal(movie){
    modalPoster.src = movie.poster;
    modalPoster.alt = movie.title + " poster";
    posterFallback(modalPoster, movie.title);
    modalTitle.textContent = movie.title;

    modalMeta.innerHTML = "";
    ["📅 " + movie.releaseDate, movie.rating ? "⭐ " + movie.rating : "⭐ TBA", "⚡ " + movie.phase, "🎬 " + movie.importance].forEach(t => {
        const s = document.createElement("span");
        s.textContent = t;
        modalMeta.appendChild(s);
    });

    modalDescription.textContent = movie.description || "No details available.";

    if(movie.trailerUrl){
        modalTrailerBtn.style.display = "inline-flex";
        modalTrailerBtn.disabled = false;
        modalTrailerBtn.onclick = () => window.open(movie.trailerUrl, "_blank");
    } else {
        modalTrailerBtn.style.display = "none";
    }

    modalWatchBtn.textContent = watched[movie.id] ? "✓ Watched" : "✓ Mark Watched";
    modalWatchBtn.onclick = () => {
        watched[movie.id] = !watched[movie.id];
        modalWatchBtn.textContent = watched[movie.id] ? "✓ Watched" : "✓ Mark Watched";
        playButtonSound(); saveData(); renderMovies();
    };

    modalFavoriteBtn.textContent = favorites[movie.id] ? "❤️ Favorited" : "♡ Favorite";
    modalFavoriteBtn.onclick = () => {
        favorites[movie.id] = !favorites[movie.id];
        modalFavoriteBtn.textContent = favorites[movie.id] ? "❤️ Favorited" : "♡ Favorite";
        playButtonSound(); saveData(); renderMovies();
    };

    if(movie.downloadUrl && movie.downloadUrl.trim() !== ""){
        modalDownloadBtn.style.display = "inline-flex";
        modalDownloadBtn.disabled = false;
        modalDownloadBtn.textContent = "⬇ Download";
        modalDownloadBtn.onclick = () => window.open(movie.downloadUrl, "_blank");
    } else {
        modalDownloadBtn.style.display = "inline-flex";
        modalDownloadBtn.disabled = true;
        modalDownloadBtn.textContent = "⬇ Coming Soon";
        modalDownloadBtn.onclick = null;
    }

    if(movie.upcoming && movie.releaseDate){
        modalComingSoon.style.display = "block";
        startModalTimer(movie.releaseDate);
    } else {
        modalComingSoon.style.display = "none";
        stopModalTimer();
    }

    movieModal.classList.add("active");
    movieModal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
}

function closeMovieModal(){
    movieModal.classList.remove("active");
    movieModal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    stopModalTimer();
}

movieModalClose.addEventListener("click", closeMovieModal);
movieModal.addEventListener("click", e => { if(e.target === movieModal) closeMovieModal(); });
document.addEventListener("keydown", e => {
    if(e.key === "Escape" && movieModal.classList.contains("active")) closeMovieModal();
});

/* Doomsday timer */
const DOOMSDAY = Date.parse("2026-12-18T00:00:00+05:30");
function tickDoomsday(){
    const diff = Math.max(0, DOOMSDAY - Date.now());
    const t = Math.floor(diff / 1000);
    const pad = n => String(n).padStart(2, "0");
    const d = document.getElementById("doomsdayDays");
    const h = document.getElementById("doomsdayHours");
    const m = document.getElementById("doomsdayMinutes");
    const s = document.getElementById("doomsdaySeconds");
    if(d) d.textContent = String(Math.floor(t / 86400)).padStart(3, "0");
    if(h) h.textContent = pad(Math.floor((t % 86400) / 3600));
    if(m) m.textContent = pad(Math.floor((t % 3600) / 60));
    if(s) s.textContent = pad(t % 60);
}
setInterval(tickDoomsday, 1000);
tickDoomsday();

/* Coming soon timers */
function startAllComingTimers(){
    document.querySelectorAll(".coming-timer").forEach(el => {
        const target = Date.parse(el.dataset.release);
        if(isNaN(target)) return;
        function tick(){
            const diff = Math.max(0, target - Date.now());
            const t = Math.floor(diff / 1000);
            const d = el.querySelector('[data-u="d"]');
            const h = el.querySelector('[data-u="h"]');
            const m = el.querySelector('[data-u="m"]');
            const s = el.querySelector('[data-u="s"]');
            if(d) d.textContent = String(Math.floor(t / 86400)).padStart(3, "0");
            if(h) h.textContent = String(Math.floor((t % 86400) / 3600)).padStart(2, "0");
            if(m) m.textContent = String(Math.floor((t % 3600) / 60)).padStart(2, "0");
            if(s) s.textContent = String(t % 60).padStart(2, "0");
        }
        tick();
        if(el._interval) clearInterval(el._interval);
        el._interval = setInterval(tick, 1000);
    });
}

function startModalTimer(dateStr){
    stopModalTimer();
    const target = Date.parse(dateStr + "T00:00:00+05:30");
    if(isNaN(target)) return;
    function tick(){
        const diff = Math.max(0, target - Date.now());
        const t = Math.floor(diff / 1000);
        const pad = n => String(n).padStart(2, "0");
        const d = document.getElementById("modalTimerDays");
        const h = document.getElementById("modalTimerHours");
        const m = document.getElementById("modalTimerMinutes");
        const s = document.getElementById("modalTimerSeconds");
        if(d) d.textContent = String(Math.floor(t / 86400)).padStart(3, "0");
        if(h) h.textContent = pad(Math.floor((t % 86400) / 3600));
        if(m) m.textContent = pad(Math.floor((t % 3600) / 60));
        if(s) s.textContent = pad(t % 60);
    }
    tick();
    modalTimerInterval = setInterval(tick, 1000);
}
function stopModalTimer(){
    if(modalTimerInterval){ clearInterval(modalTimerInterval); modalTimerInterval = null; }
}

